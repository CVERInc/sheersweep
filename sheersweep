#!/usr/bin/env bash
# sheersweep — the Mac cleaner you can read.
# Open source · dry-run first · hard never-touch list · sweeps every account.
# https://oss.cver.net/sheersweep  ·  MIT © CVER Inc.
#
# DEFAULT SWEEP (no subcommand):
#   Only clears caches/temp/logs that the OS and apps rebuild automatically,
#   then releases the local APFS snapshots that pin freed space. It NEVER touches
#   your real files — see the NEVER-TOUCH list below. Read every line; that's the point.
#
# UNINSTALL (`sheersweep uninstall [App]`) — an opt-in, dangerous-by-nature verb:
#   Finds EVERYTHING that belongs to one app (the .app plus its per-account
#   preferences / caches / containers / launch agents) across EVERY account,
#   matched by the app's bundle identifier — never by a fuzzy name. Run it with no
#   name for an interactive numbered picker. It SHOWS you the full list with sizes
#   and waits for you to type the app's name. It then MOVES (never rm) each item
#   into the owning account's Trash, so every deletion is recoverable. Emptying
#   the Trash is what finally reclaims the space.
set -u

VERSION="0.3.1"

# ============================================================================
# i18n — en-US / ja-JP / zh-TW. Auto-detected; override with SHEERSWEEP_LANG.
# (Just strings. The safety logic is further down and language-independent.)
# ============================================================================
ss_resolve_lang() {
  local l="${SHEERSWEEP_LANG:-${LANG:-}}"
  [ -z "$l" ] && l="$(defaults read -g AppleLocale 2>/dev/null || true)"
  case "$l" in
    ja*|*ja_JP*|*ja-JP*)        echo "ja-JP" ;;
    *zh*Hant*|*zh_TW*|*zh-TW*)  echo "zh-TW" ;;   # Traditional only (Simplified → English)
    *)                          echo "en-US" ;;
  esac
}
SS_LANG="$(ss_resolve_lang)"

# t KEY → localized string. Parameterized strings use {placeholders}.
t() {
  case "$1" in
    escalate)
      case "$SS_LANG" in
        ja-JP) echo "全アカウントを掃除するには管理者権限が必要です — sudo で再実行します…" ;;
        zh-TW) echo "清掃所有帳號需要管理員權限——以 sudo 重新執行…" ;;
        *)     echo "Sweeping every account needs admin rights — re-running with sudo…" ;;
      esac ;;
    dry_banner)
      case "$SS_LANG" in
        ja-JP) echo "🧪 ドライラン — 何も削除しません" ;;
        zh-TW) echo "🧪 預演（DRY-RUN）——不會刪除任何東西" ;;
        *)     echo "🧪 DRY-RUN — nothing will be deleted" ;;
      esac ;;
    free_before)
      case "$SS_LANG" in
        ja-JP) echo "クリーン前の空き容量：" ;;
        zh-TW) echo "清理前可用：" ;;
        *)     echo "Free before: " ;;
      esac ;;
    free_after)
      case "$SS_LANG" in
        ja-JP) echo "クリーン後の空き容量：" ;;
        zh-TW) echo "清理後可用：" ;;
        *)     echo "Free after:  " ;;
      esac ;;
    reclaimed)
      case "$SS_LANG" in
        ja-JP) echo "回収した容量：" ;;
        zh-TW) echo "本輪回收：" ;;
        *)     echo "Reclaimed:   " ;;
      esac ;;
    acct)
      case "$SS_LANG" in
        ja-JP) echo "アカウント：" ;;
        zh-TW) echo "帳號：" ;;
        *)     echo "account: " ;;
      esac ;;
    system)
      case "$SS_LANG" in
        ja-JP) echo "システム" ;;
        zh-TW) echo "系統" ;;
        *)     echo "system" ;;
      esac ;;
    brew)   # {user}
      case "$SS_LANG" in
        ja-JP) echo "homebrew クリーンアップ（{user} として）" ;;
        zh-TW) echo "homebrew 清理（以 {user}）" ;;
        *)     echo "homebrew cleanup (as {user})" ;;
      esac ;;
    snap_dry)
      case "$SS_LANG" in
        ja-JP) echo "ローカルスナップショット（ドライランでは保持）" ;;
        zh-TW) echo "本機快照（預演保留）" ;;
        *)     echo "local snapshots (dry-run keeps them)" ;;
      esac ;;
    snap_count)   # {n}
      case "$SS_LANG" in
        ja-JP) echo "ローカルスナップショットが {n} 個 — 本番実行で削除し空き容量を解放します" ;;
        zh-TW) echo "目前有 {n} 個本機快照——正式執行會刪掉以釋放空間" ;;
        *)     echo "{n} local snapshot(s) present — a real run deletes them to free space" ;;
      esac ;;
    snap_release)
      case "$SS_LANG" in
        ja-JP) echo "ローカルスナップショットを解放中" ;;
        zh-TW) echo "釋放本機快照" ;;
        *)     echo "releasing local snapshots" ;;
      esac ;;
    snap_fail)
      case "$SS_LANG" in
        ja-JP) echo "⚠️ スナップショットを解放できませんでした（tmutil がエラーを返しました）。空き容量がスナップショットに保持されたままの可能性があります。" ;;
        zh-TW) echo "⚠️ 無法釋放快照（tmutil 回報錯誤）。空間可能仍被快照釘住。" ;;
        *)     echo "⚠️ could not release snapshots (tmutil reported an error) — space may still be pinned by them." ;;
      esac ;;
    snap_notool)
      case "$SS_LANG" in
        ja-JP) echo "（tmutil が見つかりません — スナップショットの解放をスキップ）" ;;
        zh-TW) echo "（找不到 tmutil——略過快照釋放）" ;;
        *)     echo "(tmutil not found — skipping snapshot release)" ;;
      esac ;;
    preview)
      case "$SS_LANG" in
        ja-JP) echo "［予定］" ;;
        zh-TW) echo "［預覽］" ;;
        *)     echo "[preview]" ;;
      esac ;;
    freeing)
      case "$SS_LANG" in
        ja-JP) echo "解放" ;;
        zh-TW) echo "釋放" ;;
        *)     echo "free  " ;;
      esac ;;
    unknown)   # {opt}
      case "$SS_LANG" in
        ja-JP) echo "sheersweep: 不明なオプション '{opt}'（--help を参照）" ;;
        zh-TW) echo "sheersweep：未知選項 '{opt}'（請看 --help）" ;;
        *)     echo "sheersweep: unknown option '{opt}' (try --help)" ;;
      esac ;;
    not_macos)
      case "$SS_LANG" in
        ja-JP) echo "🔴 sheersweep は macOS 専用です（tmutil・APFS・/Users レイアウト・~/.Trash に依存）。現在の OS: {os}。中止します。" ;;
        zh-TW) echo "🔴 sheersweep 只支援 macOS（依賴 tmutil、APFS、/Users 結構、~/.Trash）。目前作業系統：{os}。已中止。" ;;
        *)     echo "🔴 sheersweep is macOS-only (it relies on tmutil, APFS, the /Users layout, and ~/.Trash). Current OS: {os}. Aborting." ;;
      esac ;;

    # ---- uninstall flow ----
    un_usage)
      case "$SS_LANG" in
        ja-JP) echo "uninstall にはアプリ名が必要です:  sheersweep uninstall <App>" ;;
        zh-TW) echo "uninstall 需要一個 App 名稱：sheersweep uninstall <App>" ;;
        *)     echo "uninstall needs an app name:  sheersweep uninstall <App>" ;;
      esac ;;
    un_pick_header)
      case "$SS_LANG" in
        ja-JP) echo "アンインストールできるアプリ:" ;;
        zh-TW) echo "可卸載的 App：" ;;
        *)     echo "Apps you can uninstall:" ;;
      esac ;;
    un_pick_prompt)
      case "$SS_LANG" in
        ja-JP) echo "番号を入力して選択（q でキャンセル）: " ;;
        zh-TW) echo "輸入編號選擇（q 取消）：" ;;
        *)     echo "Enter a number to choose (q to cancel): " ;;
      esac ;;
    un_pick_invalid)
      case "$SS_LANG" in
        ja-JP) echo "無効な選択です。" ;;
        zh-TW) echo "不是有效的編號。" ;;
        *)     echo "Not a valid choice." ;;
      esac ;;
    un_pick_none)
      case "$SS_LANG" in
        ja-JP) echo "アンインストールできるアプリが見つかりません。" ;;
        zh-TW) echo "找不到可卸載的 App。" ;;
        *)     echo "No removable apps found." ;;
      esac ;;
    un_notfound)   # {app}
      case "$SS_LANG" in
        ja-JP) echo "❌ '{app}' というアプリが見つかりません（/Applications と ~/Applications を確認）" ;;
        zh-TW) echo "❌ 找不到名為「{app}」的 App（已找過 /Applications 與 ~/Applications）" ;;
        *)     echo "❌ no app named '{app}' (looked in /Applications and ~/Applications)" ;;
      esac ;;
    un_refuse_apple)   # {app}
      case "$SS_LANG" in
        ja-JP) echo "🔴 拒否：{app} は Apple／システムのアプリです。封印された読み取り専用のシステムボリューム上にあり、root でも削除できません（削除しても容量は戻りません）。" ;;
        zh-TW) echo "🔴 拒絕：{app} 是 Apple／系統 App，住在已封印的唯讀系統卷上——連 root 都刪不掉（刪了也不會釋放空間）。" ;;
        *)     echo "🔴 refusing: {app} is an Apple / system app on the sealed, read-only system volume — not even root can remove it (and deleting it wouldn't free space)." ;;
      esac ;;
    un_refuse_nobid)   # {app}
      case "$SS_LANG" in
        ja-JP) echo "🔴 拒否：{app} に bundle id がありません。安全に照合できないため中止します。" ;;
        zh-TW) echo "🔴 拒絕：{app} 沒有 bundle id，無法安全比對，已中止。" ;;
        *)     echo "🔴 refusing: {app} has no bundle id — can't match its files safely, aborting." ;;
      esac ;;
    un_resolved)   # {app}  ·  {bid}
      case "$SS_LANG" in
        ja-JP) echo "アプリ: {app}   ·   bundle id: {bid}" ;;
        zh-TW) echo "App：{app}   ·   bundle id：{bid}" ;;
        *)     echo "App: {app}   ·   bundle id: {bid}" ;;
      esac ;;
    un_header)   # {app}
      case "$SS_LANG" in
        ja-JP) echo "{app} に属するもの（すべてゴミ箱へ移動 — 復元可能）:" ;;
        zh-TW) echo "屬於 {app} 的所有東西（會移到垃圾桶——可救回）：" ;;
        *)     echo "Everything that belongs to {app} (moves to Trash — recoverable):" ;;
      esac ;;
    un_empty)   # {app}
      case "$SS_LANG" in
        ja-JP) echo "{app} に属するファイルは見つかりませんでした。" ;;
        zh-TW) echo "找不到任何屬於 {app} 的檔案。" ;;
        *)     echo "Found nothing belonging to {app}." ;;
      esac ;;
    un_total)
      case "$SS_LANG" in
        ja-JP) echo "合計:        " ;;
        zh-TW) echo "合計：       " ;;
        *)     echo "Total:       " ;;
      esac ;;
    un_dry_note)
      case "$SS_LANG" in
        ja-JP) echo "🧪 プレビュー — 何も移動していません。uninstall するには --dry-run なしで実行。" ;;
        zh-TW) echo "🧪 預覽——什麼都沒動。要真的卸載請拿掉 --dry-run 再執行。" ;;
        *)     echo "🧪 preview — nothing moved. Run without --dry-run to uninstall." ;;
      esac ;;
    un_confirm)   # {name}
      case "$SS_LANG" in
        ja-JP) echo "上記すべてをゴミ箱へ移動するにはアプリ名「{name}」を入力（それ以外でキャンセル）: " ;;
        zh-TW) echo "要把以上全部移到垃圾桶，請輸入 App 名稱「{name}」（輸入其他則取消）：" ;;
        *)     echo "Type the app name '{name}' to move all of the above to Trash (anything else cancels): " ;;
      esac ;;
    un_cancelled)
      case "$SS_LANG" in
        ja-JP) echo "キャンセルしました — 何も変更していません。" ;;
        zh-TW) echo "已取消——什麼都沒動。" ;;
        *)     echo "Cancelled — nothing was touched." ;;
      esac ;;
    un_quit)   # {app}
      case "$SS_LANG" in
        ja-JP) echo "{app} は起動中のようです — 先に終了を依頼します…" ;;
        zh-TW) echo "{app} 看起來正在執行——先請它結束…" ;;
        *)     echo "{app} looks like it's running — asking it to quit first…" ;;
      esac ;;
    un_trashing)
      case "$SS_LANG" in
        ja-JP) echo "ゴミ箱へ" ;;
        zh-TW) echo "移到垃圾桶" ;;
        *)     echo "to Trash" ;;
      esac ;;
    un_done)   # {app}
      case "$SS_LANG" in
        ja-JP) echo "✅ {app} をゴミ箱へ移動しました。容量を取り戻すにはゴミ箱を空に。元に戻すには: sheersweep restore" ;;
        zh-TW) echo "✅ {app} 已移到垃圾桶。要真正釋放空間請清空垃圾桶；想還原打：sheersweep restore" ;;
        *)     echo "✅ {app} moved to Trash. Empty the Trash to reclaim the space — or undo with: sheersweep restore" ;;
      esac ;;
    un_refuse_protected)   # {app}
      case "$SS_LANG" in
        ja-JP) echo "🔴 拒否：{app} はシステムに組み込まれており（firmlink）、削除できません。" ;;
        zh-TW) echo "🔴 拒絕：{app} 接進系統核心（firmlink），無法移除。" ;;
        *)     echo "🔴 refusing: {app} is wired into the system (firmlink) and can't be removed." ;;
      esac ;;

    # ---- restore (undo the last uninstall) ----
    rs_none)
      case "$SS_LANG" in
        ja-JP) echo "復元できるものがありません — アンインストールの記録が見つかりません。" ;;
        zh-TW) echo "沒有可還原的東西——找不到任何卸載紀錄。" ;;
        *)     echo "Nothing to restore — no uninstall receipts found." ;;
      esac ;;
    rs_header)   # {app}  ·  {date}
      case "$SS_LANG" in
        ja-JP) echo "最後のアンインストールを復元: {app}   ·   {date}" ;;
        zh-TW) echo "要還原最後一次卸載：{app}   ·   {date}" ;;
        *)     echo "Restoring the last uninstall: {app}   ·   {date}" ;;
      esac ;;
    rs_confirm)
      case "$SS_LANG" in
        ja-JP) echo "上記をすべて元の場所へ戻しますか？ [y/N]: " ;;
        zh-TW) echo "把以上全部放回原處？ [y/N]：" ;;
        *)     echo "Put all of the above back where they came from? [y/N]: " ;;
      esac ;;
    rs_restoring)
      case "$SS_LANG" in
        ja-JP) echo "復元" ;;
        zh-TW) echo "還原" ;;
        *)     echo "restore" ;;
      esac ;;
    rs_skip)   # {path}
      case "$SS_LANG" in
        ja-JP) echo "スキップ（すでに存在）: {path}" ;;
        zh-TW) echo "略過（已存在）：{path}" ;;
        *)     echo "skip (already there): {path}" ;;
      esac ;;
    rs_fail)   # {path}
      case "$SS_LANG" in
        ja-JP) echo "⚠️ 復元できませんでした: {path}" ;;
        zh-TW) echo "⚠️ 無法還原：{path}" ;;
        *)     echo "⚠️ could not restore: {path}" ;;
      esac ;;
    rs_done)   # {app}
      case "$SS_LANG" in
        ja-JP) echo "✅ {app} を元の場所へ復元しました。" ;;
        zh-TW) echo "✅ {app} 已放回原處。" ;;
        *)     echo "✅ Restored {app} to where it was." ;;
      esac ;;
    rs_list_header)
      case "$SS_LANG" in
        ja-JP) echo "これまでのアンインストール（新しい順）:" ;;
        zh-TW) echo "歷次卸載（新到舊）：" ;;
        *)     echo "Past uninstalls (newest first):" ;;
      esac ;;
  esac
}

