          APP_TARGET="$arg"
        elif [ "$MODE" = "reclaim" ]; then
          RC_ROOTS+=("$arg")               # explicit scan roots override the defaults
        else
          m="$(t unknown)"; echo "${m//\{opt\}/$arg}" >&2; exit 2
        fi ;;
    esac
  done
  if [ "$stale_pending" -eq 1 ]; then        # --stale was the last word
    m="$(t unknown)"; echo "${m//\{opt\}/--stale}" >&2; exit 2
  fi

  # uninstall with no app name is fine on a terminal (we'll show a picker after
  # escalation). With no TTY there's nothing to pick from → fail before sudo.
  if [ "$MODE" = "uninstall" ] && [ -z "$APP_TARGET" ] && [ ! -t 0 ]; then
    t un_usage >&2; exit 2
  fi
  # reclaim's real run is interactive (select + typed confirm); its --dry-run
  # is a pure report and stays headless-friendly.
  if [ "$MODE" = "reclaim" ] && [ "$DRY" -eq 0 ] && [ ! -t 0 ]; then
    t rc_usage >&2; exit 2
  fi

  # macOS-only: everything below assumes tmutil, APFS, the /Users home layout and
  # ~/.Trash. --version / --help already exited above, so they work anywhere; any
  # mode that actually touches the disk refuses to run on a non-macOS host rather
  # than misbehaving against a Linux/other filesystem layout.
  if [ "$(uname -s)" != "Darwin" ]; then
    m="$(t not_macos)"; echo "${m//\{os\}/$(uname -s)}" >&2; exit 1
  fi

  # --- disk-touching modes read every account, which needs root; re-exec with
  # sudo. `tools` is the exception: a read-only inventory of the CURRENT user's
  # tool world — nothing is written, no other account is read, and brew refuses
  # to run as root anyway → it must NOT demand a password.
  if [ "$(id -u)" -ne 0 ] && [ "$MODE" != "tools" ]; then
    t escalate
    exec sudo SHEERSWEEP_LANG="$SS_LANG" SHEERSWEEP_SUSPECT_MIN_MB="${SHEERSWEEP_SUSPECT_MIN_MB:-}" "$0" "$@"
  fi
  REAL_USER="${SUDO_USER:-$(id -un)}"
  REAL_HOME="$(dscl . -read "/Users/$REAL_USER" NFSHomeDirectory 2>/dev/null | awk '{print $2}')"
  [ -n "$REAL_HOME" ] || REAL_HOME="/Users/$REAL_USER"
fi

human()  { du -sh "$1" 2>/dev/null | cut -f1; }
free_kb() { df -k /System/Volumes/Data | awk '/Data$/{print $4}'; }

# Strip terminal control bytes (C0 + DEL) from an untrusted string before it is
# printed to the consent screen. A macOS filename or plist value may contain any
# byte but '/' and NUL — including ESC/CSI — and these are printed just above the
# typed-confirm prompt that the whole tool's safety rests on; without this, a
# name from another account could erase the "Total:" line or forge reassuring
# text. Display-only: the real path used for the move is the raw, unsanitized
# value, so a control byte in a name never changes WHAT is trashed, only how the
# preview reads. LC_ALL=C so the ranges are bytes, not multibyte-aware.
vis() { LC_ALL=C tr -d '\000-\037\177'; }

# Clear a directory's CONTENTS (keep the dir). Dry-run only reports the size.
clean() {
  local p="$1" sz
  [ -d "$p" ] || return 0
  sz="$(human "$p")"
  if [ -z "$sz" ] || [ "$sz" = "0B" ]; then return 0; fi
  if [ "$DRY" -eq 1 ]; then
    printf '   %s %6s  %s\n' "$(t preview)" "$sz" "$p"
  else
    printf '   %s %6s  %s\n' "$(t freeing)" "$sz" "$p"
    find "$p" -mindepth 1 -delete 2>/dev/null
  fi
}

# ============================================================================
# uninstall <App> — opt-in, dangerous-by-nature. Find one app's whole footprint
# across every account by BUNDLE ID, preview it, then MOVE it to Trash (never rm).
# Kept self-contained so the safety story reads top-to-bottom in one place.
# ============================================================================

# Resolve a name/path to an .app bundle. Sets RESOLVED_APP ("" if not found).
resolve_app() {
  RESOLVED_APP=""
  local q="$1" base hit
  case "$q" in
    /*) [ -d "$q" ] && RESOLVED_APP="$q"; return ;;   # explicit path wins
  esac
  base="$q"; case "$base" in *.app) ;; *) base="$base.app" ;; esac
  # Search roots: the shared locations plus EVERY account's ~/Applications, not
  # just the invoker's. The footprint collector already sweeps `for home in
  # /Users/*`, so a name that could be DELETED across accounts must also be
  # RESOLVABLE across them — otherwise `uninstall <name>` sees less than it can
  # remove (the sheer < sweep gap this tool exists to close). Inheriting a Mac:
  # the previous owner's app lives only under their home, and naming it must find
  # it. Own home first so a same-named app resolves to yours before a stranger's.
  # Don't assume REAL_HOME is already set — resolve_app must be correct called on
  # its own, not only after the uninstall preamble that fills it.
  local rh="${REAL_HOME:-$HOME}"
  local d roots=("/Applications" "/Applications/Utilities" "$rh/Applications")
  for d in /Users/*/Applications; do
    case "$d" in "$rh/Applications") continue ;; esac   # already first
    [ -d "$d" ] && roots+=("$d")
  done
  for d in "${roots[@]}"; do
    if [ -d "$d/$base" ]; then RESOLVED_APP="$d/$base"; return; fi
  done
  # case-insensitive fallback (Spotlight-free). Match by name and read the first
  # NUL-delimited hit, so a name with spaces/newlines is preserved; validate with
  # `[ -d ]` (follows symlinks) so a symlinked .app resolves too.
  while IFS= read -r -d '' hit; do
    [ -d "$hit" ] || continue
    RESOLVED_APP="$hit"; break
  done < <(find "${roots[@]}" -maxdepth 2 -iname "$base" -not -path '*.app/*' -print0 2>/dev/null)
}

# Read CFBundleIdentifier from an .app (empty if unreadable).
bundle_id() {
  defaults read "$1/Contents/Info" CFBundleIdentifier 2>/dev/null \
    || /usr/libexec/PlistBuddy -c 'Print :CFBundleIdentifier' "$1/Contents/Info.plist" 2>/dev/null
}

# ── Vendor-nested app data: the catalog that closes the "uninstall left a GB
# behind" gap ────────────────────────────────────────────────────────────────
# Some apps DON'T store their data at Application Support/<AppName> or /<bundle
# id> — they nest it under a VENDOR folder: Chrome lives in
#   ~/Library/Application Support/Google/Chrome
# not /Google Chrome and not /com.google.Chrome, so do_uninstall's standard
# patterns can't see it (this is exactly why a real `uninstall Google Chrome`
# moved only the .app + a prefs plist and left ~1 GB of profile behind). These
# paths are listed here BY BUNDLE ID — never a fuzzy name — one path relative to
# ~/Library per line. Two hard rules keep it safe:
#   • Only ever a PRODUCT subfolder (Google/Chrome), NEVER the vendor root
#     (Google/): that root also holds Google Drive's DriveFS and the shared
#     updater, which belong to a DIFFERENT, often still-installed app.
#   • extra_is_safe() below refuses, at runtime, to add a known shared vendor
#     root — so even a typo here can't reach a sibling app's data.
catalog_extra_rel() {   # $1 = bundle id → ~/Library-relative paths, one per line
  case "$1" in
    com.google.Chrome)
      printf '%s\n' "Application Support/Google/Chrome" "Caches/Google/Chrome" ;;
    com.google.Chrome.canary)
      printf '%s\n' "Application Support/Google/Chrome Canary" "Caches/Google/Chrome Canary" ;;
    com.microsoft.edgemac)
      printf '%s\n' "Application Support/Microsoft Edge" "Caches/Microsoft Edge" ;;
    com.brave.Browser)
      printf '%s\n' "Application Support/BraveSoftware/Brave-Browser" "Caches/BraveSoftware/Brave-Browser" ;;
    com.vivaldi.Vivaldi)
      printf '%s\n' "Application Support/Vivaldi" "Caches/Vivaldi" ;;
    company.thebrowser.Browser)
      printf '%s\n' "Application Support/Arc" "Caches/Arc" ;;
    org.chromium.Chromium)
      printf '%s\n' "Application Support/Chromium" "Caches/Chromium" ;;
  esac
}

# Map a display name → bundle id for apps whose .app may already be gone, so
# `uninstall <name>` can still finish the job. Exact match only (a curated table,
# not a fuzzy guess) — the result is still a bundle id, honoring sheersweep's
# "match by bundle id, never a name" rule.
catalog_bid_for_name() {   # $1 = app name (no .app) → bundle id, empty if unknown
  case "$1" in
    "Google Chrome")        echo "com.google.Chrome" ;;
    "Google Chrome Canary") echo "com.google.Chrome.canary" ;;
    "Microsoft Edge")       echo "com.microsoft.edgemac" ;;
    "Brave Browser")        echo "com.brave.Browser" ;;
    "Vivaldi")              echo "com.vivaldi.Vivaldi" ;;
    "Arc")                  echo "company.thebrowser.Browser" ;;
    "Chromium")             echo "org.chromium.Chromium" ;;
  esac
}
catalog_name_for_bid() {   # reverse, for the display banner when the .app is gone
  case "$1" in
    com.google.Chrome)          echo "Google Chrome" ;;
    com.google.Chrome.canary)   echo "Google Chrome Canary" ;;
    com.microsoft.edgemac)      echo "Microsoft Edge" ;;
    com.brave.Browser)          echo "Brave Browser" ;;
    com.vivaldi.Vivaldi)        echo "Vivaldi" ;;
    company.thebrowser.Browser) echo "Arc" ;;
    org.chromium.Chromium)      echo "Chromium" ;;
  esac
}

# Runtime guard: refuse to treat a SHARED VENDOR ROOT as removable app data.
# These folders hold more than one app's data (Application Support/Google also
# contains Google Drive's DriveFS and the shared GoogleUpdater), so removing the
# whole folder on a browser uninstall would delete a different — possibly still
# installed — app's data. The catalog only ever lists product subfolders; this is
# the belt-and-suspenders that makes a future typo impossible to act on.
extra_is_safe() {   # $1 = ~/Library-relative path → returns 0 = safe, 1 = refuse
  case "$1" in
    "Application Support/Google"|"Caches/Google")                 return 1 ;;
    "Application Support/BraveSoftware"|"Caches/BraveSoftware")   return 1 ;;
    "Application Support/Microsoft"|"Caches/Microsoft")           return 1 ;;
  esac
  return 0
}

# ── Orphan-data DISCOVERY: find what apps you removed long ago left behind ──
# The sweep never touches app data, and uninstalling by name needs a name — so
# data from an app deleted years ago just sits there forever. This finder closes
# that gap while staying inside the "identity, never a guess" rule: a big share
# of app data is named BY BUNDLE ID (Containers/<id>, Preferences/<id>.plist, …).
# Enumerate every id that owns such data, subtract every id an installed app
# claims, and what's left is PROVABLY orphaned — no fuzzy matching anywhere.
# Application Support folders named after a VENDOR (Adobe, Spotify) can't be
# proved and are never surfaced; those stay the hand-curated catalog's job.

looks_like_bid() {   # $1 → 0 if it has the shape of an APP's bundle id (com.vendor.app)
  case "$1" in
    *.*) ;; *) return 1 ;;                 # at least one dot
  esac
  case "$1" in
    .*|*.) return 1 ;;                      # no leading/trailing dot
    *[!A-Za-z0-9.-]*) return 1 ;;           # the id charset, nothing else
    # the group NAMESPACE is never an app's identity, in any of its three
    # spellings (group.* / systemgroup.* / 10-char TEAM-ID first label). It
    # shows up as Preferences plists and Application Scripts sandboxes too —
    # a live Google Drive's group surfaced as a 6 MB "orphan" before this.
    group.*|systemgroup.*) return 1 ;;
  esac
  case "${1%%.*}" in
    [A-Z0-9][A-Z0-9][A-Z0-9][A-Z0-9][A-Z0-9][A-Z0-9][A-Z0-9][A-Z0-9][A-Z0-9][A-Z0-9]) return 1 ;;
  esac
  return 0
}

# Every claim installed software makes on id-named data. Fills two lists:
#   CLAIMED_IDS   — each CFBundleIdentifier found in installed bundles, INCLUDING
#                   every Info.plist nested inside a non-Apple .app (XPC services,
#                   login items, Electron helpers): a helper's Containers/<id> is
#                   a live app's data even though no top-level id matches it, and
#                   a dot-prefix rule alone can't prove that (com.adobe.acc.installer
#                   shares no prefix with any Adobe app's own id).
#                   Apple-id bundles aren't descended into — Xcode alone nests
#                   thousands of Info.plists, all com.apple.*, and com.apple.* is
#                   unconditionally kept anyway (see bid filtering below).
#   CLAIMED_NAMES — each app's folder name: zoom.us.app names its Application
#                   Support folder "zoom.us" — id-shaped, but claimed by NAME.
# Args override the scan roots (for tests); default = every Applications folder.
CLAIMS_READY=0
# shellcheck disable=SC2120  # args are the test seam; production calls take the default
collect_claims() {
  CLAIMED_IDS=""; CLAIMED_NAMES=""
  local roots=() sys=1 d appp base bid f nested lp prog
  if [ "$#" -gt 0 ]; then roots=("$@"); sys=0; else
    # beyond the Applications folders: driver/updater suites park their bundles
    # in /Library — Wacom's helper apps live in /Library/PrivilegedHelperTools,
    # Google's updater in /Library/Application Support — and missing those
    # turned a LIVE driver's data into an "orphan" on a real Mac.
    roots=("/Applications" "/Library/Application Support" "/Library/PrivilegedHelperTools")
    for d in /Users/*/Applications; do [ -d "$d" ] && roots+=("$d"); done
  fi
  while IFS= read -r -d '' appp; do
    [ -d "$appp" ] || continue
    base="$(basename "$appp")"
    CLAIMED_NAMES="$CLAIMED_NAMES${base%.app}"$'\n'
    bid="$(bundle_id "$appp")"
    [ -n "$bid" ] && CLAIMED_IDS="$CLAIMED_IDS$bid"$'\n'
    case "$bid" in ""|com.apple.*) continue ;; esac
    while IFS= read -r -d '' f; do
      nested="$(/usr/libexec/PlistBuddy -c 'Print :CFBundleIdentifier' "$f" 2>/dev/null)"
      [ -n "$nested" ] && CLAIMED_IDS="$CLAIMED_IDS$nested"$'\n'
    done < <(find "$appp" -name Info.plist -print0 2>/dev/null)
  done < <(
    for d in "${roots[@]}"; do
      [ -d "$d" ] && find "$d" -name '*.app' -prune -print0 2>/dev/null
    done
  )
  # Living background software claims its label too: a Launch Agent/Daemon whose
  # program still EXISTS on disk is installed software, whether or not any
  # bundle carries its id — some daemons are raw binaries with no .app at all.
  # One whose program is GONE claims nothing: that corpse is exactly what
  # `leftovers` hunts, and its data SHOULD surface here. Same live/dead line.
  if [ "$sys" -eq 1 ]; then
    for lp in /Library/LaunchDaemons/*.plist /Library/LaunchAgents/*.plist \
              /Users/*/Library/LaunchAgents/*.plist; do
      [ -f "$lp" ] || continue
      prog="$(/usr/libexec/PlistBuddy -c 'Print :Program' "$lp" 2>/dev/null)"
      [ -z "$prog" ] && prog="$(/usr/libexec/PlistBuddy -c 'Print :ProgramArguments:0' "$lp" 2>/dev/null)"
      { [ -n "$prog" ] && [ -e "$prog" ]; } || continue
      CLAIMED_IDS="$CLAIMED_IDS$(basename "$lp" .plist)"$'\n'
    done
  fi
  CLAIMS_READY=1
}
# ^ that bundle scan is FULL depth, pruned at each bundle: vendors nest apps in
# subfolders — /Applications/CLIP STUDIO 1.5/App/CLIP STUDIO PAINT.app is three
# levels down, its helpers four — and a shallow scan here turned a LIVE app's
# extension containers into "orphans" on a real Mac. Prune keeps it cheap:
# nothing inside a bundle is walked twice; the per-app find handles the inside.
# (Comment lives out here: bash 3.2 can't parse a parenthesis in a comment
# inside process substitution.)

# stdin: candidate ids, one per line → stdout: only the ones NO claim covers.
# Every rule errs toward "claimed" (= kept): exact id, exact app-folder name,
# dot-prefix in either direction (com.foo.Chrome.helper ↔ com.foo.Chrome), and
# com.apple.* never surfaces at all — system components own ids with no .app.
filter_unclaimed() {
  # the lists ride the environment, not -v: BSD awk refuses newlines in -v
  CLAIMS="$CLAIMED_IDS" NAMES="$CLAIMED_NAMES" LC_ALL=C awk '
    BEGIN {
      n = split(ENVIRON["CLAIMS"], C, "\n"); m = split(ENVIRON["NAMES"], N, "\n")
      for (i = 1; i <= n; i++) if (C[i] != "") claimed[C[i]] = 1
      for (i = 1; i <= m; i++) if (N[i] != "") byname[N[i]] = 1
    }
    {
      if ($0 ~ /^com\.apple\./) next
      if ($0 in claimed || $0 in byname) next
      for (c in claimed) {
        if (index($0, c ".") == 1) next      # candidate is a child of a claimed id
        if (index(c, $0 ".") == 1) next      # candidate is a parent of a claimed id
      }
      print
    }'
}

# Emit the id-shaped owners of data under one account's Library, one per line.
# (Dupes fine — the caller sorts -u.) Vendor-NAME folders don't pass
# looks_like_bid, so they can never become candidates. Two deliberate silences:
#   • `group.*` entries (Group Containers, Application Scripts) NEVER nominate a
#     candidate — an app group is a shared space, not an app's identity, and its
#     membership lives in entitlements no Info.plist scan can prove (Apple's own
#     Shortcuts owns group.is.workflow.* with no matching bundle id anywhere).
#     A proven orphan's group data still rides along: orphan_paths_home and
#     do_uninstall both match Group Containers by the already-proven id.
#   • Application Support entries must be DIRECTORIES — the folder root also
#     collects loose files with id-ish names (SwiftData's default.store) that
#     name a file format, not an app.
orphan_candidates() {   # $1 = home
  local L="$1/Library" f b
  for f in "$L/Containers"/* "$L/WebKit"/* "$L/HTTPStorages"/*; do
    [ -e "$f" ] || continue
    b="$(basename "$f")"; b="${b%.binarycookies}"
    looks_like_bid "$b" && printf '%s\n' "$b"
  done
  for f in "$L/Application Support"/* ; do
    [ -d "$f" ] || continue
    b="$(basename "$f")"
    looks_like_bid "$b" && printf '%s\n' "$b"
  done
  for f in "$L/Application Scripts"/*; do
    [ -e "$f" ] || continue
    b="$(basename "$f")"
    # group-namespace sandboxes live here too — looks_like_bid rejects them
    looks_like_bid "$b" && printf '%s\n' "$b"
  done
  for f in "$L/Saved Application State"/*.savedState; do
    [ -e "$f" ] || continue
    b="$(basename "$f" .savedState)"
    looks_like_bid "$b" && printf '%s\n' "$b"
  done
  for f in "$L/Preferences"/*.plist "$L/Cookies"/*.binarycookies; do
    [ -e "$f" ] || continue
    b="$(basename "$f")"; b="${b%.plist}"; b="${b%.binarycookies}"
    looks_like_bid "$b" && printf '%s\n' "$b"
  done
}

# All id-named paths <id> owns under <home>/Library — the same patterns
# do_uninstall's footprint uses, id-anchored only (we have no trustworthy name).
# NUL-delimited: a hostile sibling account controls these names.
orphan_paths_home() {   # $1 = id  $2 = home
  local id="$1" L="$2/Library" f
  for f in "$L/Application Support/$id" "$L/Caches/$id" \
           "$L/Containers/$id" "$L/Saved Application State/$id.savedState" \
           "$L/WebKit/$id" "$L/Cookies/$id.binarycookies" \
           "$L/Application Scripts/$id" "$L/Preferences/$id.plist"; do
    [ -e "$f" ] && printf '%s\0' "$f"
  done
  for f in "$L/Preferences/$id".*.plist "$L/HTTPStorages/$id"* \
           "$L/Group Containers/"*"$id"* "$L/LaunchAgents/$id"*.plist; do
    [ -e "$f" ] && printf '%s\0' "$f"
  done
}

# Does any id-named data exist for this id, in any real account?
orphan_has_data() {   # $1 = id
  local home
  for home in /Users/*; do
    [ -d "$home/Library" ] || continue
    case "$(basename "$home")" in Shared|Guest) continue ;; esac
    [ -n "$(orphan_paths_home "$1" "$home" | head -c1)" ] && return 0
  done
  return 1
}

# "Strong" data = the families worth a person's attention on their own
# (Containers / Application Support / Group Containers / Saved State). A lone
# 4 KB preferences plist is real but shouldn't crowd the picker — dozens of
# those accumulate on any old Mac.
orphan_is_strong() {   # $1 = id  $2… = homes
  local id="$1" h f; shift
  for h in "$@"; do
    for f in "$h/Library/Containers/$id" "$h/Library/Application Support/$id" \
             "$h/Library/Saved Application State/$id.savedState"; do
      [ -e "$f" ] && return 0
    done
    for f in "$h/Library/Group Containers/"*"$id"*; do
      [ -e "$f" ] && return 0
    done
  done
  return 1
}

# A recognition hint from the id itself — clearly marked as a guess by the
# caller's "(…?)" wrapper, because the id is the only identity we can prove.
orphan_hint() {   # $1 = id → one lowercase word, "" if nothing useful
  local last prev
  last="${1##*.}"; prev="${1%.*}"; prev="${prev##*.}"
  case "$(printf '%s' "$last" | LC_ALL=C tr '[:upper:]' '[:lower:]')" in
    client|app|mac|macos|osx|desktop|helper|agent|main|core|ui|gui|com|net|org) last="$prev" ;;
  esac
  printf '%s' "$last" | LC_ALL=C tr '[:upper:]' '[:lower:]'
}

od_human_kb() {   # KB → "12K" / "340M" / "1.2G" (matches du -h's vocabulary)
  awk -v k="${1:-0}" 'BEGIN {
    if (k >= 1048576)   printf "%.1fG", k / 1048576
    else if (k >= 1024) printf "%.0fM", k / 1024
    else                printf "%dK", k
  }'
}

# The discovery driver. Requires collect_claims to have run. Fills, largest
# first: OD_IDS / OD_SIZE / OD_HINT (a strong family or ≥ 1 MB) and, below the
# fold, OD_TIDS / OD_TSIZE / OD_THINT — the small stuff (a lone preferences
# plist and the like). The tail is LISTED, not hidden: size-sorting already
# sinks it to the bottom, and hiding evidence behind a count line would be a
# verdict — the one thing this tool promises not to make for you. Args
# override the homes to scan (for tests); default = every real /Users home.
# shellcheck disable=SC2120  # args are the test seam; production calls take the default
orphan_discover() {
  OD_IDS=(); OD_SIZE=(); OD_HINT=(); OD_KB=()
  OD_TIDS=(); OD_TSIZE=(); OD_THINT=(); OD_TKB=()
  local homes=() home id kb rows="" tail="" paths=() p
  if [ "$#" -gt 0 ]; then homes=("$@"); else
    for home in /Users/*; do
      [ -d "$home/Library" ] || continue
      case "$(basename "$home")" in Shared|Guest) continue ;; esac
      homes+=("$home")
    done
  fi
  [ "${#homes[@]}" -eq 0 ] && return 0
  while IFS= read -r id; do
    [ -z "$id" ] && continue
    paths=()
    while IFS= read -r -d '' p; do paths+=("$p"); done < <(
      for home in "${homes[@]}"; do orphan_paths_home "$id" "$home"; done)
    [ "${#paths[@]}" -eq 0 ] && continue
    kb="$(du -sk "${paths[@]}" 2>/dev/null | awk '{s += $1} END {print s + 0}')"
    if orphan_is_strong "$id" "${homes[@]}" || [ "${kb:-0}" -ge 1024 ]; then
      rows="$rows$kb $id"$'\n'
    else
      tail="$tail$kb $id"$'\n'
    fi
  done < <(
    for home in "${homes[@]}"; do orphan_candidates "$home"; done \
      | LC_ALL=C sort -u | filter_unclaimed
  )
  while read -r kb id; do
    [ -z "$id" ] && continue
    OD_IDS+=("$id"); OD_SIZE+=("$(od_human_kb "$kb")"); OD_HINT+=("$(orphan_hint "$id")"); OD_KB+=("$kb")
  done < <(printf '%s' "$rows" | LC_ALL=C sort -rn)
  while read -r kb id; do
    [ -z "$id" ] && continue
    OD_TIDS+=("$id"); OD_TSIZE+=("$(od_human_kb "$kb")"); OD_THINT+=("$(orphan_hint "$id")"); OD_TKB+=("$kb")
  done < <(printf '%s' "$tail" | LC_ALL=C sort -rn)
}

# Parse a picker selection: one number, several ("5 7-8 19", commas ok), or
# `all` (= every 🧟 orphan row — never the apps: "all" must not be able to
# mean "uninstall everything installed"). Fills PICK_ROWS with unique rows.
# A multi selection may MIX app and 🧟 rows: selection is batch, consent is
# not — downstream, each app still gets its own one-at-a-time typed-name
# confirmation (precise surgery), while 🧟 residue gets batch consent
# (housekeeping; see do_uninstall_orphans). Returns 0 = ok · 1 = invalid.
pick_parse() {   # $1 = input  $2 = app-row count  $3 = total row count
  local input="$1" napps="$2" total="$3" tok lo hi k seen=" "
  PICK_ROWS=()
  input="${input//,/ }"
  case "$input" in
    all|ALL)
      [ "$total" -le "$napps" ] && return 1    # nothing discovered → no "all"
      k=$((napps + 1))
      while [ "$k" -le "$total" ]; do PICK_ROWS+=("$k"); k=$((k + 1)); done
      return 0 ;;
  esac
  for tok in $input; do
    case "$tok" in
      *-*) lo="${tok%%-*}"; hi="${tok#*-}" ;;
      *)   lo="$tok";       hi="$tok" ;;
    esac
    case "$lo$hi" in ''|*[!0-9]*) return 1 ;; esac
    { [ "$lo" -ge 1 ] && [ "$hi" -le "$total" ] && [ "$lo" -le "$hi" ]; } || return 1
    k="$lo"
    while [ "$k" -le "$hi" ]; do
      case "$seen" in *" $k "*) ;; *) PICK_ROWS+=("$k"); seen="$seen$k " ;; esac
      k=$((k + 1))
    done
  done
  [ "${#PICK_ROWS[@]}" -eq 0 ] && return 1
  return 0
}

orphan_row_id() {   # $1 = picker row number  $2 = app-row count → the orphan id
  local idx=$(( $1 - 1 - $2 ))
  if [ "$idx" -lt "${#OD_IDS[@]}" ]; then
    printf '%s' "${OD_IDS[$idx]}"
  else
    printf '%s' "${OD_TIDS[$((idx - ${#OD_IDS[@]}))]}"
  fi
}

# Interactive picker (mole-style): list user-removable apps, read a selection,
# set APP_TARGET (single) or PICK_ORPHANS (multi). Apple/system apps are
# filtered out. Returns with both unset on cancel / invalid input.
pick_app() {
  local apps=() appp base bid n choice m i hint odn scan_tmp="" scan_pid=""
  # Kick the orphan scan off FIRST, in the background — it takes seconds, and
  # the person is about to spend those same seconds reading the app list. By
  # the time they've browsed it, the 🧟 section is usually ready: the wait
  # hides under the reading. Results cross the process boundary via a temp
  # file of TAB rows — every field is id-shaped/size text, so no escaping.
  t un_orphan_scan
  scan_tmp="$(mktemp "${TMPDIR:-/tmp}/sheersweep-scan.XXXXXX" 2>/dev/null)" || scan_tmp=""
  if [ -n "$scan_tmp" ]; then
    (
      collect_claims
      orphan_discover
      if [ "${#OD_IDS[@]}" -gt 0 ]; then
        for i in "${!OD_IDS[@]}"; do
          printf 'M\t%s\t%s\t%s\n' "${OD_IDS[$i]}" "${OD_SIZE[$i]}" "${OD_HINT[$i]}"
        done
      fi
      if [ "${#OD_TIDS[@]}" -gt 0 ]; then
        for i in "${!OD_TIDS[@]}"; do
          printf 'T\t%s\t%s\t%s\n' "${OD_TIDS[$i]}" "${OD_TSIZE[$i]}" "${OD_THINT[$i]}"
        done
      fi
    ) > "$scan_tmp" 2>/dev/null &
    scan_pid=$!
  fi
  # Scan /Applications and ~/Applications, one folder deep (so apps nested in a
  # subfolder like "CLIP STUDIO 1.5/CLIP STUDIO.app" show up) — but NEVER descend
  # into a .app bundle (its embedded helper .apps aren't separate apps).
  # NUL-delimited end to end (find -print0 · sort -z · read -d '') so an app whose
  # name contains a space, quote, or even a newline can't split or corrupt the list.
  # We match by NAME (not -type d) and validate with `[ -d ]`, which follows
  # symlinks — so a symlinked .app still appears. `-not -path '*.app/*'` keeps us
  # from descending into a bundle's embedded helper apps; without -L, find never
  # follows the symlink itself, so there's no traversal loop.
  while IFS= read -r -d '' appp; do
    [ -d "$appp" ] || continue
    bid="$(bundle_id "$appp")"
    # These folders are writable (never /System), so any Apple app found here is
    # removable — except the firmlinked ones (Safari).
    case "$bid" in ""|com.apple.Safari|com.apple.SafariTechnologyPreview) continue ;; esac
    apps+=("$appp")
  done < <(
    for d in "/Applications" "$REAL_HOME/Applications"; do
      [ -d "$d" ] && find "$d" -maxdepth 2 -name '*.app' -not -path '*.app/*' -print0 2>/dev/null
    done | sort -z
  )
  if [ "${#apps[@]}" -eq 0 ]; then t un_pick_none >&2; return 3; fi
  # ── DISCOVERY join — data left behind by apps already removed. The apps were
  # only COLLECTED above, not printed, on purpose: a menu that arrives in halves
  # reads as a stutter, and the second half showing up seconds late is exactly
  # the moment a person starts typing against a list that's about to change.
  # One announced wait up front (the 🔍 line), then the whole menu in one piece.
  # The app enumeration itself overlapped the scan; if mktemp failed, scan inline.
  if [ -n "$scan_tmp" ]; then
    wait "$scan_pid" 2>/dev/null
    OD_IDS=(); OD_SIZE=(); OD_HINT=(); OD_TIDS=(); OD_TSIZE=(); OD_THINT=()
    local tier idv szv hv
    while IFS=$'\t' read -r tier idv szv hv; do
      case "$tier" in
        M) OD_IDS+=("$idv");  OD_SIZE+=("$szv");  OD_HINT+=("$hv") ;;
        T) OD_TIDS+=("$idv"); OD_TSIZE+=("$szv"); OD_THINT+=("$hv") ;;
      esac
    done < "$scan_tmp"
    rm -f "$scan_tmp"
    # note: the claim lists live only in that subshell — a single-orphan pick
    # re-scans claims inside do_uninstall, which is guarded and correct.
  else
    collect_claims
    orphan_discover
  fi
  # ── now the whole menu, in one breath: apps, then what apps left behind ──
  printf '%s (%d)\n' "$(t un_pick_header)" "${#apps[@]}"   # show the full count → no hidden "next page"
  n=0
  for appp in "${apps[@]}"; do
    n=$((n + 1))
    base="$(basename "$appp")"; base="${base%.app}"
    printf '  %3d) %s\n' "$n" "$(printf '%s' "$base" | vis)"
  done
  # 🧟 rows are numbered continuously with the apps; picking one runs the same
  # footprint→preview→typed-confirm→Trash→receipt flow, keyed by the bundle id.
  odn="${#OD_IDS[@]}"
  if [ "$odn" -gt 0 ]; then
    m="$(t un_orphan_header)"; echo "${m//\{n\}/$odn}"
    for i in "${!OD_IDS[@]}"; do
      n=$((n + 1))
      hint="${OD_HINT[$i]}"; [ -n "$hint" ] && hint="  ($hint?)"
      printf '  %3d) %-44s %6s%s\n' "$n" "${OD_IDS[$i]}" "${OD_SIZE[$i]}" "$hint"
    done
  fi
  # the small stuff is LISTED too (a divider, not a hiding place — you can't
  # select what you can't see); size-sorting already sank it down here
  if [ "${#OD_TIDS[@]}" -gt 0 ]; then
    m="$(t un_orphan_tail)"; echo "  ${m//\{n\}/${#OD_TIDS[@]}}"
    for i in "${!OD_TIDS[@]}"; do
      n=$((n + 1))
      hint="${OD_THINT[$i]}"; [ -n "$hint" ] && hint="  ($hint?)"
      printf '  %3d) %-44s %6s%s\n' "$n" "${OD_TIDS[$i]}" "${OD_TSIZE[$i]}" "$hint"
    done
  fi
  t un_pick_multi_hint   # multi works on app rows too now, so always teach it
  printf '%s' "$(t un_pick_prompt)"
  choice=""; read -r choice || true
  case "$choice" in
    ''|q|Q) return 0 ;;                            # clean cancel → caller prints un_cancelled
  esac
  if ! pick_parse "$choice" "${#apps[@]}" "$n"; then
    t un_pick_invalid >&2; return 2                 # already messaged → caller must not re-print
  fi
  if [ "${#PICK_ROWS[@]}" -eq 1 ]; then
    choice="${PICK_ROWS[0]}"
    if [ "$choice" -le "${#apps[@]}" ]; then
      APP_TARGET="${apps[$((choice - 1))]}"
    else
      APP_TARGET="$(orphan_row_id "$choice" "${#apps[@]}")"
    fi
  else
    # Mixed multi-select: batch SELECTION, serial CONSENT. App rows queue up
    # for the normal one-at-a-time flow (each still confirms by typed name);
    # 🧟 rows go to the batch flow with its count-typed consent.
    local k
    for k in "${PICK_ROWS[@]}"; do
      if [ "$k" -le "${#apps[@]}" ]; then
        PICK_APPS+=("${apps[$((k - 1))]}")
      else
        PICK_ORPHANS+=("$(orphan_row_id "$k" "${#apps[@]}")")
      fi
    done
  fi
}

# Move one path into a specific account's Trash (recoverable). $1=path $2=ownerHome
# Sets TRASH_DEST to the new location on success (empty if nothing moved), so the
# caller can record a receipt that `restore` later reads to put things back.
to_trash() {
  local item="$1" owner_home="$2" tdir base dest stamp i uid gid towner
  TRASH_DEST=""
  [ -e "$item" ] || return 0
  tdir="$owner_home/.Trash"
  uid="$(stat -f %u "$owner_home" 2>/dev/null)"
  gid="$(stat -f %g "$owner_home" 2>/dev/null)"
  # SECURITY: we run as root and mv INTO another account's ~/.Trash, which that
  # account controls. If they replace it with a symlink (→ /Library/LaunchDaemons,
  # say), a naive mv would follow the link and write our item OUTSIDE their home,
  # as root. So refuse a .Trash that is a symlink, and refuse an existing real one
  # not owned by the home's owner. (Residual: a same-account TOCTOU swap between
  # this check and the mv is a sub-ms race, not the trivial static symlink it was.)
  if [ -L "$tdir" ]; then return 0; fi
  if [ ! -d "$tdir" ]; then
    # Recreate a missing .Trash with the right OWNER and 0700 perms — a Trash owned
    # by root (or world-readable) is one Finder can't empty and other users can peek
    # into. Match the home folder's owner; mode mirrors a stock ~/.Trash.
    mkdir -p "$tdir" 2>/dev/null || return 0
    [ -n "$uid" ] && [ -n "$gid" ] && chown "$uid:$gid" "$tdir" 2>/dev/null
    chmod 700 "$tdir" 2>/dev/null
  else
    towner="$(stat -f %u "$tdir" 2>/dev/null)"
    [ -n "$uid" ] && [ -n "$towner" ] && [ "$towner" != "$uid" ] && return 0
  fi
  base="$(basename "$item")"
  dest="$tdir/$base"
  # On a name clash, find a free slot that is GUARANTEED unique even for several
  # collisions within the same second (a coarse second-stamp would clobber the
  # earlier one and lose it). Stamp to the nanosecond, then add a probe counter
  # so it works regardless of the platform date's sub-second support.
  if [ -e "$dest" ]; then
    stamp="$(date +%Y%m%d-%H%M%S-%N 2>/dev/null)"
    case "$stamp" in *N|"") stamp="$(date +%Y%m%d-%H%M%S)" ;; esac   # date without %N
    dest="$tdir/$base $stamp"
    i=1
    while [ -e "$dest" ]; do dest="$tdir/$base $stamp-$i"; i=$((i + 1)); done
  fi
  # shellcheck disable=SC2034  # read by trash_one and the callers' receipt writers
  if mv "$item" "$dest" 2>/dev/null; then TRASH_DEST="$dest"; fi
}

# One attempted move, honestly accounted: prints the item, tries to_trash,
# writes the receipt pair — and says ❌ OUT LOUD when nothing moved. A silent
# skip is how three real runs "succeeded" while every macOS-protected app
# container stayed put and the summary still claimed ✅. Uses the caller's
# MV_TRIED / MV_MOVED / MV_STUCK_CONT via bash dynamic scoping — declare them
# in the caller before the loop.
trash_one() {   # $1 = path  $2 = owner-home  $3 = receipt file
  printf '   %s  %s\n' "$(t un_trashing)" "$1"
  MV_TRIED=$((MV_TRIED + 1))
  to_trash "$1" "$2"
  if [ -n "$TRASH_DEST" ]; then
    printf '%s\0%s\0' "$TRASH_DEST" "$1" >> "$3" 2>/dev/null
    MV_MOVED=$((MV_MOVED + 1))
  else
    printf '        %s\n' "$(t un_item_stuck)"
    case "$1" in */Library/Containers/*) MV_STUCK_CONT=1 ;; esac
  fi
}

# The honest tail of every move loop: full success keeps the old one-line ✅;
# anything less becomes a 🔴 with the real numbers — and when macOS's app
# container protection is the culprit, the one line that actually helps.
report_moves() {   # $1 = the fully-successful ✅ line, already formatted
  local m
  if [ "$MV_TRIED" -gt 0 ] && [ "$MV_MOVED" -eq "$MV_TRIED" ]; then
    echo "$1"
  else
    m="$(t un_partial)"; m="${m//\{moved\}/$MV_MOVED}"; echo "${m//\{total\}/$MV_TRIED}"
    [ "$MV_STUCK_CONT" -eq 1 ] && t un_protected_hint
  fi
  return 0
}

do_uninstall() {
  local target="$1" app bid name rc orphan=0
  # an empty target must die HERE: handed to the resolvers below, "" would match
  # brew's whole Cellar listing and offer to uninstall the first formula in it
  if [ -z "$target" ]; then t un_usage >&2; return 1; fi
  resolve_app "$target"
  app="$RESOLVED_APP"
  if [ -z "$app" ]; then
    # The .app isn't there. If this is a catalog app, the human likely dragged
    # the bundle to the Trash already while a big profile stayed behind (the very
    # case this upgrade exists for). Resolve it from the catalog — by name, or as
    # a literal bundle id — so `uninstall` can still finish cleaning up. If it's
    # not a known app, there's nothing safe to match on → the original error.
    local q="${target%.app}"
    bid="$(catalog_bid_for_name "$q")"
    [ -z "$bid" ] && [ -n "$(catalog_extra_rel "$target")" ] && bid="$target"
    if [ -z "$bid" ]; then
      # Not an app and not in the app catalog — maybe it's a CLI tool. Try the
      # Homebrew resolver, then the bare-binary one; each returns 2 for "not
      # mine" (→ fall through) and otherwise owns the whole flow.
      do_uninstall_brew "$q"; rc=$?
      [ "$rc" -ne 2 ] && return "$rc"
      do_uninstall_bin "$q"; rc=$?
      [ "$rc" -ne 2 ] && return "$rc"
      # Not a tool either. If it has the SHAPE of a bundle id and owns id-named
      # data, this is the DISCOVERY flow: an app removed long ago whose data was
      # never cleaned up (how the picker's orphan rows land here). Refuse an id
      # anything installed still claims — the same claim scan the picker uses —
      # so `uninstall <bundle-id>` can never reach a live app's (or its
      # helper's) data. Only id-named paths are matched: for a gone app the id
      # is the one identity we can prove, and inventing a display name would be
      # the fuzzy match this script refuses to do.
      if looks_like_bid "$q" && orphan_has_data "$q"; then
        [ "$CLAIMS_READY" -eq 1 ] || collect_claims
        if [ -z "$(printf '%s\n' "$q" | filter_unclaimed)" ]; then
          m="$(t un_orphan_installed)"; echo "${m//\{bid\}/$q}" >&2; return 1
        fi
        bid="$q"; name="$q"; orphan=1
      else
        m="$(t un_notfound)"; echo "${m//\{app\}/$target}" >&2; return 1
      fi
    fi
    if [ "$orphan" -eq 0 ]; then
      name="$(catalog_name_for_bid "$bid")"; [ -z "$name" ] && name="$q"
      # A catalog bid typed LITERALLY while its app is still installed must not
      # slip into this already-gone flow (its Application Support is live data).
      # resolve_app failed above only because "<bid>.app" isn't a folder name —
      # so re-resolve by the catalog's display name and refuse on a hit.
      resolve_app "$name"
      if [ -n "$RESOLVED_APP" ]; then
        m="$(t un_orphan_installed)"; echo "${m//\{bid\}/$bid}" >&2; return 1
      fi
      m="$(t un_appgone)"; echo "${m//\{app\}/$name}"
    fi
    # app stays empty — that IS the "bundle already gone" state: the system-wide
    # `add "$app"` below no-ops on a missing path, so no .app is moved.
    app=""
  else
    # Refuse only what genuinely can't be removed — by WHERE it lives, not by who
    # made it. Apps on the sealed, read-only system volume (/System/*) are off
    # limits; removable Apple apps in /Applications (iMovie, GarageBand, the iWork
    # suite, Xcode…) are fair game. A tiny denylist covers Apple apps that sit in a
    # writable folder but are firmlinked into the system (Safari).
    case "$app" in
      /System/*) m="$(t un_refuse_apple)"; echo "${m//\{app\}/$app}" >&2; return 1 ;;
    esac
    bid="$(bundle_id "$app")"
    if [ -z "$bid" ]; then
      m="$(t un_refuse_nobid)"; echo "${m//\{app\}/$app}" >&2; return 1
    fi
    case "$bid" in
      com.apple.Safari|com.apple.SafariTechnologyPreview)
        m="$(t un_refuse_protected)"; echo "${m//\{app\}/$app}" >&2; return 1 ;;
    esac
    name="$(basename "$app")"; name="${name%.app}"
  fi

  # --- gather the footprint into parallel arrays (path / owner-home / scope) ---
  ITEM_PATH=(); ITEM_OWNER=(); ITEM_SCOPE=()
  local ascope=""
  add() {                       # add a path IF it exists, under the current scope
    [ -e "$1" ] || return 0
    ITEM_PATH+=("$1"); ITEM_OWNER+=("$2"); ITEM_SCOPE+=("$ascope")
  }

  local home u f rel
  for home in /Users/*; do
    [ -d "$home/Library" ] || continue
    case "$(basename "$home")" in Shared|Guest) continue ;; esac
    u="$(basename "$home")"
    ascope="$(t acct)$u"
    # name-anchored paths are skipped in the orphan (discovery) flow: there the
    # "name" IS the bundle id — adding both would list the same path twice.
    [ "$orphan" -eq 0 ] && add "$home/Library/Application Support/$name" "$home"
    add "$home/Library/Application Support/$bid"             "$home"
    add "$home/Library/Caches/$bid"                          "$home"
    [ "$orphan" -eq 0 ] && add "$home/Library/Caches/$name"  "$home"
    add "$home/Library/Preferences/$bid.plist"              "$home"
    for f in "$home/Library/Preferences/$bid".*.plist;   do add "$f" "$home"; done
    add "$home/Library/Containers/$bid"                     "$home"
    for f in "$home/Library/Group Containers/"*"$bid"*;  do add "$f" "$home"; done
    add "$home/Library/Saved Application State/$bid.savedState" "$home"
    for f in "$home/Library/HTTPStorages/$bid"*;         do add "$f" "$home"; done
    add "$home/Library/WebKit/$bid"                        "$home"
    add "$home/Library/Cookies/$bid.binarycookies"        "$home"
    add "$home/Library/Application Scripts/$bid"           "$home"
    [ "$orphan" -eq 0 ] && add "$home/Library/Logs/$name"  "$home"
    for f in "$home/Library/LaunchAgents/$bid"*.plist;   do add "$f" "$home"; done
    # vendor-nested data the standard patterns above can't reach (Chrome's
    # Google/Chrome, Brave's BraveSoftware/Brave-Browser, …). extra_is_safe()
    # refuses a shared vendor root so a sibling app (e.g. Google Drive) is never
    # swept up with the browser.
    while IFS= read -r rel; do
      [ -z "$rel" ] && continue
      extra_is_safe "$rel" && add "$home/Library/$rel" "$home"
    done < <(catalog_extra_rel "$bid")
  done

  # system-wide bits + the .app itself → the running user's Trash (Finder-like)
  ascope="$(t system)"
  add "$app"                                                "$REAL_HOME"
  [ "$orphan" -eq 0 ] && add "/Library/Application Support/$name" "$REAL_HOME"
  add "/Library/Caches/$bid"                                "$REAL_HOME"
  for f in "/Library/LaunchAgents/$bid"*.plist;        do add "$f" "$REAL_HOME"; done
  for f in "/Library/LaunchDaemons/$bid"*.plist;       do add "$f" "$REAL_HOME"; done
  for f in "/Library/PrivilegedHelperTools/$bid"*;     do add "$f" "$REAL_HOME"; done

  # --- show what we found (always; this IS the product) -----------------------
  echo "============================================================"
  if [ "$orphan" -eq 1 ]; then
    m="$(t un_orphan)"; echo "${m//\{bid\}/$bid}"
  else
    m="$(t un_resolved)"; m="${m//\{app\}/${app:-$name}}"; echo "${m//\{bid\}/$bid}"
  fi
  echo "------------------------------------------------------------"
  if [ "${#ITEM_PATH[@]}" -eq 0 ]; then
    m="$(t un_empty)"; echo "${m//\{app\}/$name}"
    echo "============================================================"
    return 0
  fi
  m="$(t un_header)"; echo "${m//\{app\}/$name}"
  local i last=""
  for i in "${!ITEM_PATH[@]}"; do
    if [ "${ITEM_SCOPE[$i]}" != "$last" ]; then echo "── ${ITEM_SCOPE[$i]} ──"; last="${ITEM_SCOPE[$i]}"; fi
    printf '   %6s  %s\n' "$(human "${ITEM_PATH[$i]}")" "$(printf '%s' "${ITEM_PATH[$i]}" | vis)"
  done
  local total
  total="$(du -sch "${ITEM_PATH[@]}" 2>/dev/null | tail -1 | cut -f1)"
  echo "------------------------------------------------------------"
  echo "$(t un_total)$total"
  echo "============================================================"

  # --- dry-run stops here; nothing is touched ---------------------------------
  if [ "$DRY" -eq 1 ]; then t un_dry_note; return 0; fi

  # --- typed-name confirmation (informed consent, GitHub-delete style) --------
  m="$(t un_confirm)"; printf '%s' "${m//\{name\}/$name}"
  local reply=""; read -r reply || true
  if [ "$reply" != "$name" ]; then t un_cancelled; return 0; fi

  # ask the app to quit (best-effort, in the real user's GUI session).
  # SECURITY: $bid is read from the target's Info.plist — attacker-authored — and
  # interpolated into an AppleScript string. A crafted CFBundleIdentifier could
  # break out and run arbitrary AppleScript/shell as REAL_USER. A real bundle id
  # is only [A-Za-z0-9.-]; if it has anything else, skip the (best-effort) quit
  # rather than risk injection — the uninstall itself proceeds regardless.
  m="$(t un_quit)"; echo "${m//\{app\}/$name}"
  case "$bid" in
    ""|*[!A-Za-z0-9.-]*) ;;   # empty or unusual → don't feed it to osascript
    *) sudo -u "$REAL_USER" osascript -e "tell application id \"$bid\" to quit" >/dev/null 2>&1 || true ;;
  esac

  # write a receipt as we move, so `restore` can undo this exact uninstall later.
  # The data rows are NUL-delimited (dest \0 orig \0) so a path containing a TAB
  # or a NEWLINE — both legal in a macOS filename — can't corrupt the parse. The
  # leading "# ..." header stays human-readable (its fields are controlled).
# shellcheck disable=SC2034  # MV_* are read/written by trash_one/report_moves via dynamic scope
  local rdir rfile stamp MV_TRIED=0 MV_MOVED=0 MV_STUCK_CONT=0
  rdir="$REAL_HOME/.sheersweep/uninstalls"
  mkdir -p "$rdir" 2>/dev/null
  stamp="$(date +%Y%m%d-%H%M%S)"
  rfile="$rdir/$stamp-$bid.tsv"
  # Header is record #1 (everything up to the first NUL); data records follow as
  # NUL-terminated dest/orig pairs. Splitting on the first NUL means neither a TAB
  # nor a NEWLINE in any path — nor in the app name — can corrupt the parse.
  {
    echo "# sheersweep uninstall receipt"
    echo "# app=$name"
    echo "# bid=$bid"
    echo "# date=$stamp"
    echo "# format=nul-pairs"   # data below: NUL-terminated dest, NUL-terminated orig, repeated
    printf '\0'                 # end-of-header sentinel: data (NUL-pairs) starts here
  } > "$rfile" 2>/dev/null
  for i in "${!ITEM_PATH[@]}"; do
    trash_one "${ITEM_PATH[$i]}" "${ITEM_OWNER[$i]}" "$rfile"
  done
  # hand the receipt to the real user (we wrote it as root)
  chown -R "$(stat -f %u "$REAL_HOME" 2>/dev/null):$(stat -f %g "$REAL_HOME" 2>/dev/null)" "$REAL_HOME/.sheersweep" 2>/dev/null
  [ "$MV_MOVED" -eq 0 ] && rm -f "$rfile" 2>/dev/null

  echo "============================================================"
  m="$(t un_done)"; report_moves "${m//\{app\}/$name}"
  return 0
}

# Batch removal of PROVEN orphans — discovery arrives in bulk (years of
# residue at once), so consent is leftovers-shaped: ONE combined preview of
# every file, grouped by id, then one explicit confirmation. Typing 42 app
# names doesn't scale, so you type the COUNT of ids shown — a number you can
# only know by having read the summary. Same Trash, one receipt, one restore.
do_uninstall_orphans() {
  local ids=("$@") nids id home p i m total last=""
  nids="${#ids[@]}"
  ITEM_PATH=(); ITEM_OWNER=(); ITEM_SCOPE=()
  for id in "${ids[@]}"; do
    for home in /Users/*; do
      [ -d "$home/Library" ] || continue
      case "$(basename "$home")" in Shared|Guest) continue ;; esac
      while IFS= read -r -d '' p; do
        ITEM_PATH+=("$p"); ITEM_OWNER+=("$home"); ITEM_SCOPE+=("$id")
      done < <(orphan_paths_home "$id" "$home")
    done
  done

  echo "============================================================"
  m="$(t un_orphans_header)"; echo "${m//\{n\}/$nids}"
  echo "------------------------------------------------------------"
  if [ "${#ITEM_PATH[@]}" -eq 0 ]; then
    m="$(t un_empty)"; echo "${m//\{app\}/orphans}"
    echo "============================================================"
    return 0
  fi
  for i in "${!ITEM_PATH[@]}"; do
    if [ "${ITEM_SCOPE[$i]}" != "$last" ]; then echo "── ${ITEM_SCOPE[$i]} ──"; last="${ITEM_SCOPE[$i]}"; fi
    printf '   %6s  %s\n' "$(human "${ITEM_PATH[$i]}")" "$(printf '%s' "${ITEM_PATH[$i]}" | vis)"
  done
  total="$(du -sch "${ITEM_PATH[@]}" 2>/dev/null | tail -1 | cut -f1)"
  echo "------------------------------------------------------------"
  echo "$(t un_total)$total"
  echo "============================================================"

  if [ "$DRY" -eq 1 ]; then t un_dry_note; return 0; fi

  m="$(t un_orphans_confirm)"; printf '%s' "${m//\{n\}/$nids}"
  local reply=""; read -r reply || true
  if [ "$reply" != "$nids" ]; then t un_cancelled; return 0; fi

# shellcheck disable=SC2034  # MV_* are read/written by trash_one/report_moves via dynamic scope
  local rdir rfile stamp MV_TRIED=0 MV_MOVED=0 MV_STUCK_CONT=0
  rdir="$REAL_HOME/.sheersweep/uninstalls"
  mkdir -p "$rdir" 2>/dev/null
  stamp="$(date +%Y%m%d-%H%M%S)"
  rfile="$rdir/$stamp-orphans.tsv"
  {
    echo "# sheersweep uninstall receipt"
    echo "# app=orphans ($nids ids)"
    echo "# bid=orphans"
    echo "# date=$stamp"
    echo "# format=nul-pairs"
    printf '\0'
  } > "$rfile" 2>/dev/null
  for i in "${!ITEM_PATH[@]}"; do
    trash_one "${ITEM_PATH[$i]}" "${ITEM_OWNER[$i]}" "$rfile"
  done
  chown -R "$(stat -f %u "$REAL_HOME" 2>/dev/null):$(stat -f %g "$REAL_HOME" 2>/dev/null)" "$REAL_HOME/.sheersweep" 2>/dev/null
  [ "$MV_MOVED" -eq 0 ] && rm -f "$rfile" 2>/dev/null

  echo "============================================================"
  m="$(t un_orphans_done)"; m="${m//\{n\}/$MV_MOVED}"
  report_moves "${m//\{ids\}/$nids}"
  return 0
}

# ============================================================================
# uninstall, CLI branches — DELEGATION, not surgery.
# A brew-installed tool is best removed by brew itself: its receipt knows the
# keg, the links, the services — and `brew install <name>` restores it more
# cleanly than any Trash copy could (a keg is a rebuildable artifact, not user
# data; hand-moving it would leave brew's links dangling). So sheersweep itself
# never deletes a file except by moving it to the Trash: everything else is a
# tool's OWN uninstaller, printed verbatim and run only after a typed confirm.
# ============================================================================

# Locate brew and run it AS THE HUMAN — brew refuses root, and sheersweep is
# usually root by the time uninstall runs. Auto-update is pinned off so no
# invocation ever touches the network. BREW_BIN empty = no Homebrew here.
#
# By the time `uninstall` reaches here we've re-exec'd under `sudo`, so PATH is
# sudo's sanitized default — which on Apple Silicon does NOT contain
# /opt/homebrew/bin, and a non-login `sh -c` won't source the profile that adds
# it. So probe the two standard prefixes by absolute path FIRST (that's where
# brew actually lives), and only fall back to a PATH lookup for a custom prefix.
# Without this, `uninstall <formula>` silently reported "no Homebrew" on every
# stock Apple Silicon Mac.
brew_locate() {
  local b
  BREW_BIN=""
  for b in /opt/homebrew/bin/brew /usr/local/bin/brew; do
    [ -x "$b" ] && { BREW_BIN="$b"; return; }
  done
  if [ "$(id -u)" -eq 0 ]; then
    BREW_BIN="$(sudo -u "$REAL_USER" -i sh -c 'command -v brew' 2>/dev/null)"
  else
    BREW_BIN="$(command -v brew 2>/dev/null)"
  fi
}
brew_run() {
  if [ "$(id -u)" -eq 0 ]; then
    sudo -u "$REAL_USER" HOMEBREW_NO_AUTO_UPDATE=1 "$BREW_BIN" "$@"
  else
    HOMEBREW_NO_AUTO_UPDATE=1 "$BREW_BIN" "$@"
  fi
}

# uninstall a Homebrew formula by delegating to brew. Returns 0 = done or
# cancelled · 1 = refused/failed · 2 = not a brew formula (caller falls through).
do_uninstall_brew() {
  local name vers deps keg sz cmd reply
  name="$1"
  # empty name would make `brew list --versions` dump EVERY installed formula
  [ -z "$name" ] && return 2
  brew_locate
  [ -z "$BREW_BIN" ] && return 2
  name="$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')"   # formula names are lowercase
  vers="$(brew_run list --formula --versions "$name" 2>/dev/null | head -1)"
  [ -z "$vers" ] && return 2
  name="${vers%% *}"                                        # brew's canonical short name
  vers="${vers#* }"
  # Refuse if any INSTALLED formula depends on it — removing it would break them.
  deps="$(brew_run uses --installed "$name" 2>/dev/null | tr '\n' ' ')"
  if [ -n "${deps// }" ]; then
    m="$(t un_brew_deps)"; m="${m//\{name\}/$name}"; echo "${m//\{deps\}/$deps}" >&2
    return 1
  fi
  keg="$(brew_run --cellar 2>/dev/null)/$name"
  sz="$(du -sh "$keg" 2>/dev/null | cut -f1)"
  cmd="brew uninstall $name"
  echo "============================================================"
  m="$(t un_brew_resolved)"; m="${m//\{name\}/$name}"; echo "${m//\{ver\}/$vers}"
  echo "------------------------------------------------------------"
  printf '   %6s  %s\n' "${sz:-?}" "$keg"
  echo "------------------------------------------------------------"
  t un_brew_cmd
  printf '\n      %s\n\n' "$cmd"
  m="$(t un_brew_config)"; echo "${m//\{name\}/$name}"
  echo "============================================================"
  if [ "$DRY" -eq 1 ]; then t un_dry_note; return 0; fi
  m="$(t un_brew_confirm)"; printf '%s' "${m//\{name\}/$name}"
  reply=""; read -r reply || true
  if [ "$reply" != "$name" ]; then t un_cancelled; return 0; fi
  brew_run uninstall "$name" || return 1
  m="$(t un_brew_done)"; m="${m//\{name\}/$name}"; echo "${m//\{ver\}/$vers}"
  # If this was the last formula needing some dependencies, say so — but never
  # auto-run autoremove: the consent above covered ONE formula, not a batch.
  [ -n "$(brew_run autoremove --dry-run 2>/dev/null)" ] && t un_brew_orphans
  return 0
}

# Print (NUL-delimited) the hand-installed binaries in $2's personal bin dirs
# and /usr/local/bin — skipping anything a manager or an app owns: symlinks into
# a Homebrew keg (…/Cellar/…, …/Homebrew/…) or into an .app bundle (e.g. Docker
# Desktop's /usr/local/bin/docker). Those have real uninstallers; a bare binary
# has only us. $1 = exact name to match, or "" for the full inventory.
unmanaged_bins() {
  local q="$1" home="$2" d f tgt
  for d in "$home/bin" "$home/.local/bin" "/usr/local/bin"; do
    [ -d "$d" ] || continue
    for f in "$d"/*; do
      [ -f "$f" ] || continue    # follows symlinks; skips dirs and dangling links
      [ -x "$f" ] || continue    # (two lines: older shellcheck flags `A && B || C` as SC2015)
      [ -n "$q" ] && [ "$(basename "$f")" != "$q" ] && continue
      if [ -L "$f" ]; then
        tgt="$(readlink "$f")"
        case "$tgt" in */Cellar/*|*/Homebrew/*|*.app/*) continue ;; esac
      fi
      printf '%s\0' "$f"
    done
  done
}

# uninstall a hand-installed bare binary. No receipt anywhere knows its
# footprint, so sheersweep stays honest: it moves ONLY the binary itself to the
# Trash (recoverable via `restore`) and says out loud that any data the tool
# kept elsewhere is beyond what anyone can match safely by name.
# Returns 0 = done or cancelled · 2 = no such binary (caller reports not-found).
do_uninstall_bin() {
  local q="$1" hits=() f sz reply
  while IFS= read -r -d '' f; do hits+=("$f"); done < <(unmanaged_bins "$q" "$REAL_HOME")
  [ "${#hits[@]}" -eq 0 ] && return 2
  echo "============================================================"
  t un_bin_header
  echo "------------------------------------------------------------"
  for f in "${hits[@]}"; do
    sz="$(du -shL "$f" 2>/dev/null | cut -f1)"
    printf '   %6s  %s\n' "${sz:-?}" "$f"
  done
  echo "------------------------------------------------------------"
  t un_bin_note
  echo "============================================================"
  if [ "$DRY" -eq 1 ]; then t un_dry_note; return 0; fi
  m="$(t un_bin_confirm)"; printf '%s' "${m//\{name\}/$q}"
  reply=""; read -r reply || true
  if [ "$reply" != "$q" ]; then t un_cancelled; return 0; fi
  # same receipt store and format as an app uninstall → `restore` undoes this too
# shellcheck disable=SC2034  # MV_* are read/written by trash_one/report_moves via dynamic scope
  local rdir rfile stamp MV_TRIED=0 MV_MOVED=0 MV_STUCK_CONT=0
  rdir="$REAL_HOME/.sheersweep/uninstalls"
  mkdir -p "$rdir" 2>/dev/null
  stamp="$(date +%Y%m%d-%H%M%S)"
  rfile="$rdir/$stamp-bin-$q.tsv"
  {
    echo "# sheersweep uninstall receipt"
    echo "# app=$q"
    echo "# bid=unmanaged-binary"
    echo "# date=$stamp"
    echo "# format=nul-pairs"
    printf '\0'
  } > "$rfile" 2>/dev/null
  for f in "${hits[@]}"; do
    trash_one "$f" "$REAL_HOME" "$rfile"
  done
  chown -R "$(stat -f %u "$REAL_HOME" 2>/dev/null):$(stat -f %g "$REAL_HOME" 2>/dev/null)" "$REAL_HOME/.sheersweep" 2>/dev/null
  [ "$MV_MOVED" -eq 0 ] && rm -f "$rfile" 2>/dev/null
  echo "============================================================"
  m="$(t un_done)"; report_moves "${m//\{app\}/$q}"
  return 0
}

# ============================================================================
# tools — a read-only inventory of the CLI side of this Mac: the formulae YOU
# chose (leaves), orphaned dependencies, hand-installed binaries no manager
# owns, and the big toolchain data folders — each with the native way to remove
# it. This verb changes NOTHING and never asks for a password; sheersweep only
# ever removes a CLI tool via `uninstall`, which delegates (see above).
# ============================================================================
do_tools() {
  local line name vers sz cellar leaves orphans f n rel hint p outdated newv up=0
  echo "============================================================"
  t tl_banner
  echo "------------------------------------------------------------"

  # ---- Homebrew: what you chose, and what nothing needs anymore --------------
  brew_locate
  if [ -z "$BREW_BIN" ]; then
    t tl_nobrew
  else
    t tl_brew_header
    leaves="$(brew_run leaves 2>/dev/null)"
    if [ -n "$leaves" ]; then
      cellar="$(brew_run --cellar 2>/dev/null)"
      # Upgrade nudges, DELEGATED and OFFLINE: `brew outdated` only compares
      # installed kegs against brew's LOCAL index — whatever the last
      # `brew update` fetched. No network is touched here; brew_run pins
      # auto-update off. Freshness is honestly bounded by that index, and the
      # summary line below says so.
      outdated="$(brew_run outdated --formula --verbose 2>/dev/null)"
      # shellcheck disable=SC2086  # formula names never contain spaces; splitting is the point
      while IFS= read -r line; do
        [ -z "$line" ] && continue
        name="${line%% *}"; vers="${line#* }"
        sz="$(du -sh "$cellar/$name" 2>/dev/null | cut -f1)"
        newv="$(printf '%s\n' "$outdated" | LC_ALL=C awk -v n="$name" '$1 == n {print $NF; exit}')"
        if [ -n "$newv" ]; then
          printf '   %6s  %-24s %-12s ↑ %-10s brew upgrade %s\n' "${sz:-?}" "$name" "$vers" "$newv" "$name"
          up=$((up + 1))
        else
          printf '   %6s  %-24s %s\n' "${sz:-?}" "$name" "$vers"
        fi
      done < <(brew_run list --formula --versions $leaves 2>/dev/null)
      if [ "$up" -gt 0 ]; then
        m="$(t tl_upgradable)"; echo "   ${m//\{n\}/$up}"
      fi
    fi
    echo "------------------------------------------------------------"
    orphans="$(brew_run autoremove --dry-run 2>/dev/null)"
    if [ -z "$orphans" ]; then
      t tl_orphans_none
    else
      t tl_orphans_header
      printf '%s\n' "$orphans" | grep -v '^==>' | sed 's/^/   /'
    fi
  fi
  echo "------------------------------------------------------------"

  # ---- hand-installed binaries no manager owns --------------------------------
  t tl_bins_header
  n=0
  while IFS= read -r -d '' f; do
    n=$((n + 1))
    sz="$(du -shL "$f" 2>/dev/null | cut -f1)"
    if [ -L "$f" ]; then
      printf '   %6s  %s → %s\n' "${sz:-?}" "$f" "$(readlink "$f")"
    else
      printf '   %6s  %s\n' "${sz:-?}" "$f"
    fi
  done < <(unmanaged_bins "" "$REAL_HOME")
  [ "$n" -eq 0 ] && echo "   $(t tl_bins_none)"
  echo "------------------------------------------------------------"

  # ---- toolchain data folders (informational — each row shows the NATIVE way
  # to reclaim it; sheersweep never touches these) ------------------------------
  t tl_chains_header
  n=0
  while IFS='|' read -r rel hint; do
    [ -z "$rel" ] && continue
    p="$REAL_HOME/$rel"
    [ -d "$p" ] || continue
    sz="$(du -sh "$p" 2>/dev/null | cut -f1)"
    case "$sz" in ""|0B) continue ;; esac
    n=$((n + 1))
    # shellcheck disable=SC2088  # the literal "~/" is display text, not a path
    printf '   %6s  %-22s %s\n' "$sz" "~/$rel" "$hint"
  done <<'CHAINS'
.rustup|rustup self uninstall
.cargo|removed by: rustup self uninstall
go|Go workspace · go clean -modcache
.pyenv|pyenv — Python versions/shims
.nvm|nvm — Node versions
.sdkman|SDKMAN
.dotnet|.NET SDK data
.m2|Maven cache
.gradle|Gradle (the default sweep already clears its caches)
Library/Android|Android Studio → SDK Manager
.android|Android emulator/adb data
CHAINS
  [ "$n" -eq 0 ] && echo "   $(t tl_bins_none)"
  echo "------------------------------------------------------------"
  t tl_hint
  echo "============================================================"
  return 0
}

# ============================================================================
# restore — undo the last uninstall (or list past ones). Reads the receipt and
# moves each item from the Trash back to exactly where it came from.
# ============================================================================
# Read one "# key=value" field from a receipt's header record — the first
# NUL-delimited record, i.e. the bytes before the first NUL. Scoping the read to
# the header means data bytes can never be mistaken for a header line. We use
# bash's own NUL-aware `read -d ''` because BSD awk can't split on NUL.
# $1=file $2=key
receipt_header() {
  local hdr line
  IFS= read -r -d '' hdr < "$1" 2>/dev/null || return 0
  while IFS= read -r line; do
    case "$line" in "# $2="*) printf '%s\n' "${line#"# $2="}"; return 0 ;; esac
  done <<EOF
$hdr
EOF
}

# Same, but EVERY value of a repeated key (a reclaim receipt carries one
# `# rebuild=` line per build command).
receipt_header_all() {
  local hdr line
  IFS= read -r -d '' hdr < "$1" 2>/dev/null || return 0
  while IFS= read -r line; do
    case "$line" in "# $2="*) printf '%s\n' "${line#"# $2="}" ;; esac
  done <<EOF
$hdr
EOF
}

# Count the data pairs in a receipt (dest+orig per item), robust to TAB/NEWLINE
# in paths: skip the header record, then count NUL-delimited fields and halve.
receipt_count() {
  local hdr fld n=0
  { IFS= read -r -d '' hdr || true
    while IFS= read -r -d '' fld; do n=$((n + 1)); done
  } < "$1" 2>/dev/null
  echo $((n / 2))
}

# Stream the receipt's data fields (dest, orig, dest, …) as NUL-delimited records,
# skipping the header. Callers pair them up with `read -r -d ''`.
receipt_data() {
  local hdr fld
  { IFS= read -r -d '' hdr || true
    while IFS= read -r -d '' fld; do printf '%s\0' "$fld"; done
  } < "$1" 2>/dev/null
}

do_restore() {
  local rdir newest claimed app date dest orig restored=0 failed=0
  rdir="$REAL_HOME/.sheersweep/uninstalls"

  if [ "$RESTORE_LIST" -eq 1 ]; then
    t rs_list_header
    local f had=0
    for f in "$rdir"/*.tsv "$rdir"/*.tsv.restored; do
      [ -e "$f" ] || continue
      had=1
      app="$(receipt_header "$f" app)"
      date="$(receipt_header "$f" date)"
      local n; n="$(receipt_count "$f")"
      local mark=""; case "$f" in *.restored) mark="$(t rs_restored)" ;; esac
      local nrow; nrow="$(t rs_list_count)"; nrow="${nrow//\{n\}/$n}"
      printf '   %s   ·   %s   ·   %s%s\n' "$date" "$app" "$nrow" "$mark"
    done
    [ "$had" -eq 0 ] && t rs_none
    return 0
  fi

  # newest un-restored receipt
  newest=""
  local f
  for f in "$rdir"/*.tsv; do [ -e "$f" ] && newest="$f"; done   # glob is sorted → last = newest
  if [ -z "$newest" ]; then t rs_none; return 0; fi

  app="$(receipt_header "$newest" app)"
  date="$(receipt_header "$newest" date)"
  echo "============================================================"
  m="$(t rs_header)"; m="${m//\{app\}/$app}"; echo "${m//\{date\}/$date}"
  echo "------------------------------------------------------------"
  while IFS= read -r -d '' dest && IFS= read -r -d '' orig; do
    printf '   %s\n' "$orig"
  done < <(receipt_data "$newest")
  # a reclaim receipt knows how to REBUILD what it moved — surface that at the
  # decision point, so "don't restore, rebuild clean" is a choice, not trivia
  if [ "$(receipt_header "$newest" kind)" = "reclaim" ]; then
    echo "------------------------------------------------------------"
    t rs_rebuild_hint
    receipt_header_all "$newest" rebuild | sed 's/^/   /'
  fi
  echo "============================================================"

  printf '%s' "$(t rs_confirm)"
  local reply=""; read -r reply || true
  case "$reply" in y|Y|yes|YES) ;; *) t un_cancelled; return 0 ;; esac

  # Claim this receipt atomically BEFORE touching anything: rename it to a
  # ".restoring" name. `mv` (rename(2)) is atomic, so two concurrent restores
  # can't both grab the same receipt — the loser's mv fails and it backs off,
  # and a concurrent uninstall's brand-new receipt is untouched (different name).
  claimed="$newest.restoring.$$"
  if ! mv "$newest" "$claimed" 2>/dev/null; then t rs_none; return 0; fi

  while IFS= read -r -d '' dest && IFS= read -r -d '' orig; do
    if [ ! -e "$dest" ]; then continue; fi
    if [ -e "$orig" ]; then m="$(t rs_skip)"; echo "   ${m//\{path\}/$orig}"; continue; fi
    # SECURITY (same class as to_trash): the owner of orig's home could swap its
    # parent for a symlink after the uninstall, redirecting this root-run mv to
    # write outside their home. Refuse a symlinked parent rather than follow it.
    if [ -L "$(dirname "$orig")" ]; then
      m="$(t rs_fail)"; echo "   ${m//\{path\}/$orig}" >&2; failed=$((failed + 1)); continue
    fi
    if ! mkdir -p "$(dirname "$orig")" 2>/dev/null; then
      m="$(t rs_fail)"; echo "   ${m//\{path\}/$orig}" >&2; failed=$((failed + 1)); continue
    fi
    # mv falls back to copy+remove across filesystems, so a Trash on a different
    # volume than the original location still restores correctly.
    if mv "$dest" "$orig" 2>/dev/null; then
      printf '   %s  %s\n' "$(t rs_restoring)" "$orig"
      restored=$((restored + 1))
    else
      m="$(t rs_fail)"; echo "   ${m//\{path\}/$orig}" >&2; failed=$((failed + 1))
    fi
  done < <(receipt_data "$claimed")

  mv "$claimed" "$newest.restored" 2>/dev/null
  chown -R "$(stat -f %u "$REAL_HOME" 2>/dev/null):$(stat -f %g "$REAL_HOME" 2>/dev/null)" "$REAL_HOME/.sheersweep" 2>/dev/null
  echo "============================================================"
  m="$(t rs_done)"; echo "${m//\{app\}/$app}"
  [ "$failed" -gt 0 ] && return 1
  return 0
}

# ============================================================================
# leftovers — find orphaned startup/background items (LaunchAgents/Daemons) from
# apps that are GONE, and (on confirmation) move them to the Trash. The honest
# part is the classification: dead vs. likely-orphan vs. LIVE-keep — so a working
# updater (e.g. one a still-installed app shares) is never mistaken for junk.
# ============================================================================
# Classify every *.plist in one launchd dir into the LF_* global arrays.
# $1 = dir, $2 = owner-home (whose Trash a removed plist would go to).
lf_scan() {
  local dir="$1" owner="$2" p prog label tier info
  [ -d "$dir" ] || return 0
  for p in "$dir"/*.plist; do
    [ -e "$p" ] || continue
    label="$(/usr/libexec/PlistBuddy -c 'Print :Label' "$p" 2>/dev/null)"
    [ -z "$label" ] && label="$(basename "$p" .plist)"
    case "$label" in com.apple.*) LF_KEPT=$((LF_KEPT + 1)); continue ;; esac  # never touch Apple's own jobs
    prog="$(/usr/libexec/PlistBuddy -c 'Print :Program' "$p" 2>/dev/null)"
    [ -z "$prog" ] && prog="$(/usr/libexec/PlistBuddy -c 'Print :ProgramArguments:0' "$p" 2>/dev/null)"
    tier="live"; info=""
    case "$prog" in
      /bin/sh|/bin/bash|/usr/bin/env|/usr/bin/python|/usr/bin/python3|/usr/bin/perl|/usr/bin/osascript|/usr/bin/ruby|"")
        # interpreter (or none): judge by the app paths it references instead.
        local refs ref anyref=0 allmissing=1
        refs="$(plutil -p "$p" 2>/dev/null | grep -oE '/Applications/[^"]+\.app' | sort -u)"
        if [ -n "$refs" ]; then
          while IFS= read -r ref; do
            [ -z "$ref" ] && continue
            anyref=1
            [ -e "$ref" ] && allmissing=0
          done <<REFS
$refs
REFS
          if [ "$anyref" -eq 1 ] && [ "$allmissing" -eq 1 ]; then
            tier="review"; info="$(printf '%s' "$refs" | head -1)"
          fi
        fi
        ;;
      /*)
        # explicit binary path → dead if that binary is gone.
        [ -e "$prog" ] || { tier="dead"; info="$prog"; }
        ;;
    esac
    case "$tier" in
      dead)   LF_DEAD_PATH+=("$p");   LF_DEAD_OWNER+=("$owner");   LF_DEAD_INFO+=("$info") ;;
      review) LF_REVIEW_PATH+=("$p"); LF_REVIEW_OWNER+=("$owner"); LF_REVIEW_INFO+=("$info") ;;
      *)      LF_KEPT=$((LF_KEPT + 1)) ;;
    esac
  done
}

do_leftovers() {
  LF_DEAD_PATH=(); LF_DEAD_OWNER=(); LF_DEAD_INFO=()
  LF_REVIEW_PATH=(); LF_REVIEW_OWNER=(); LF_REVIEW_INFO=()
  LF_KEPT=0
  local home i

  for home in /Users/*; do
    [ -d "$home/Library" ] || continue
    case "$(basename "$home")" in Shared|Guest) continue ;; esac
    lf_scan "$home/Library/LaunchAgents" "$home"
  done
  lf_scan "/Library/LaunchAgents"  "$REAL_HOME"
  lf_scan "/Library/LaunchDaemons" "$REAL_HOME"

  local ndead="${#LF_DEAD_PATH[@]}" nrev="${#LF_REVIEW_PATH[@]}"
  echo "============================================================"
  t lf_header
  if [ "$ndead" -eq 0 ] && [ "$nrev" -eq 0 ]; then
    echo "------------------------------------------------------------"
    t lf_clean
    m="$(t lf_kept)"; echo "${m//\{n\}/$LF_KEPT}"
    echo "============================================================"
    return 0
  fi
  if [ "$ndead" -gt 0 ]; then
    echo "------------------------------------------------------------"; t lf_dead_header
    for i in "${!LF_DEAD_PATH[@]}"; do
      printf '   %s\n        ↳ %s\n' "$(printf '%s' "${LF_DEAD_PATH[$i]}" | vis)" "$(printf '%s' "${LF_DEAD_INFO[$i]}" | vis)"
    done
  fi
  if [ "$nrev" -gt 0 ]; then
    echo "------------------------------------------------------------"; t lf_review_header
    for i in "${!LF_REVIEW_PATH[@]}"; do
      printf '   %s\n        ↳ %s\n' "$(printf '%s' "${LF_REVIEW_PATH[$i]}" | vis)" "$(printf '%s' "${LF_REVIEW_INFO[$i]}" | vis)"
    done
  fi
  echo "------------------------------------------------------------"
  m="$(t lf_kept)"; echo "${m//\{n\}/$LF_KEPT}"
  echo "============================================================"

  if [ "$DRY" -eq 1 ]; then t lf_dry_note; return 0; fi

  printf '%s' "$(t lf_confirm)"
  local reply=""; read -r reply || true
  local include_review=0
  case "$reply" in
    all|ALL)      include_review=1 ;;
    y|Y|yes|YES)  include_review=0 ;;
    *)            t un_cancelled; return 0 ;;
  esac

# shellcheck disable=SC2034  # MV_* are read/written by trash_one/report_moves via dynamic scope
  local rdir rfile stamp MV_TRIED=0 MV_MOVED=0 MV_STUCK_CONT=0
  rdir="$REAL_HOME/.sheersweep/uninstalls"   # same store → `restore` undoes these too
  mkdir -p "$rdir" 2>/dev/null
  stamp="$(date +%Y%m%d-%H%M%S)"
  rfile="$rdir/$stamp-leftovers.tsv"
  {
    echo "# sheersweep leftovers receipt"
    echo "# app=leftovers"
    echo "# bid=leftovers"
    echo "# date=$stamp"
    echo "# format=nul-pairs"
    printf '\0'
  } > "$rfile" 2>/dev/null

  if [ "$ndead" -gt 0 ]; then
    for i in "${!LF_DEAD_PATH[@]}"; do
      trash_one "${LF_DEAD_PATH[$i]}" "${LF_DEAD_OWNER[$i]}" "$rfile"
    done
  fi
  if [ "$include_review" -eq 1 ] && [ "$nrev" -gt 0 ]; then
    for i in "${!LF_REVIEW_PATH[@]}"; do
      trash_one "${LF_REVIEW_PATH[$i]}" "${LF_REVIEW_OWNER[$i]}" "$rfile"
    done
  fi
  chown -R "$(stat -f %u "$REAL_HOME" 2>/dev/null):$(stat -f %g "$REAL_HOME" 2>/dev/null)" "$REAL_HOME/.sheersweep" 2>/dev/null
  [ "$MV_MOVED" -eq 0 ] && rm -f "$rfile" 2>/dev/null

  echo "============================================================"
  m="$(t lf_done)"; report_moves "${m//\{n\}/$MV_MOVED}"
  return 0
}

# ============================================================================
# reclaim — build output inside project directories (docs/reclaim-spec.md).
# Opt-in, never part of the sweep. A directory is a candidate ONLY when all
# three gates hold — the conjunction is what lets us say "this is regenerable
# output, not your data":
#   ① git ignores it   ② its name is on the short build-pattern list
#   ③ a sibling manifest proves the build tool (package.json, Cargo.toml, …)
# A content folder literally named `dist` fails gate ③ and stays invisible.
# Removal is the same primitive as every other verb: preview → typed confirm →
# Trash (same-volume rename — instant, no copy) → receipt → restore. The
# receipt additionally records each REBUILD command: after a reclaim you have
# two undos — rebuild a clean tree (recommended) or put the files back.
# ============================================================================

# git, as the sweep runs it: root triggers "dubious ownership" on user repos,
# and this is read-only interrogation — allow it per-invocation, globally off.
rc_git() { git -c safe.directory='*' "$@"; }

# Gate ② — the whole allow-list, short and auditable (like the never-touch list).
RC_PATTERNS=".build node_modules target dist .next build .gradle Pods"

# The floor for the UNIDENTIFIED tier (below): only surface a heavy gitignored
# folder we CAN'T prove — small ones are noise (a stray .env, an editor cache),
# and the whole point of this tier is the fat thing you forgot. Default 512 MB;
# override with SHEERSWEEP_SUSPECT_MIN_MB for a tighter or looser floor.
RC_UNID_MIN_KB=$(( ${SHEERSWEEP_SUSPECT_MIN_MB:-512} * 1024 ))

# Gate ③ — the sibling manifest that proves each pattern's build tool.
rc_manifest_ok() {   # $1 = candidate dir NAME  $2 = parent dir → 0 = proven
  local p="$2" g
  case "$1" in
    .build)            [ -f "$p/Package.swift" ] && return 0
                       for g in "$p"/*.xcodeproj; do [ -e "$g" ] && return 0; done ;;
    node_modules|dist|.next)
                       [ -f "$p/package.json" ] && return 0 ;;
    target)            [ -f "$p/Cargo.toml" ] && return 0 ;;
    Pods)              [ -f "$p/Podfile" ] && return 0 ;;
    build|.gradle)     [ -f "$p/build.gradle" ] || [ -f "$p/build.gradle.kts" ] \
                       || [ -f "$p/settings.gradle" ] || [ -f "$p/settings.gradle.kts" ] && return 0 ;;
  esac
  return 1
}

# The one command that rebuilds a candidate — printed in the preview and
# recorded in the receipt. Node's package manager is read off the lockfile.
rc_rebuild_for() {   # $1 = candidate dir NAME  $2 = parent dir
  local pm="npm"
  case "$1" in
    node_modules|dist|.next)
      if   [ -f "$2/pnpm-lock.yaml" ]; then pm="pnpm"
      elif [ -f "$2/yarn.lock" ];      then pm="yarn"
      elif [ -f "$2/bun.lockb" ] || [ -f "$2/bun.lock" ]; then pm="bun"; fi ;;
  esac
  case "$1" in
    .build)        echo "swift build" ;;
    node_modules)  echo "$pm install" ;;
    dist|.next)    echo "$pm run build" ;;
    target)        echo "cargo build" ;;
    Pods)          echo "pod install" ;;
    build|.gradle) echo "./gradlew build" ;;
  esac
}

# Is any ancestor (candidate → scan root) an Obsidian vault? The never-touch
# list applies on top of the gates; a vault keeps plugins in gitignored dirs
# that can look exactly like build output.
rc_in_vault() {   # $1 = start dir  $2 = stop-at dir → 0 = inside a vault
  local d="$1"
  while [ -n "$d" ] && [ "$d" != "/" ]; do
    [ -d "$d/.obsidian" ] && return 0
    [ "$d" = "$2" ] && break
    d="${d%/*}"
  done
  return 1
}

# When was this repo last touched? max(last commit, newest TRACKED file mtime) —
# commit time alone would call an actively-edited-but-uncommitted repo "stale"
# and offer up the build you made this morning (the spec is explicit here).
rc_repo_touched() {   # $1 = repo top → epoch (0 if unknowable)
  local ct mt
  ct="$(rc_git -C "$1" log -1 --format=%ct 2>/dev/null)"; ct="${ct:-0}"
  mt="$(rc_git -C "$1" ls-files -z 2>/dev/null \
        | (cd "$1" 2>/dev/null && xargs -0 stat -f %m 2>/dev/null) \
        | LC_ALL=C sort -rn | head -1)"; mt="${mt:-0}"
  if [ "$ct" -ge "$mt" ]; then echo "$ct"; else echo "$mt"; fi
}

# The default scan roots, per home: a short, readable list of common dev
# folders — never a walk of the whole home. Explicit CLI paths override.
rc_roots_for_home() {   # $1 = home → NUL-terminated roots that exist
  local r
  for r in Developer Projects projects Code code src repos workspace; do
    [ -d "$1/$r" ] && printf '%s\0' "$1/$r"
  done
}

# Scan one root: find candidate-named dirs, pruned — we never descend into a
# match (top-most wins; nested node_modules stay inside their parent), never
# into .git, and never into cloud-sync mirrors. The name tests are generated
# from RC_PATTERNS so the allow-list truly lives in one line.
rc_scan_root() {   # $1 = root → NUL paths of pattern-named dirs
  local names=() p
  for p in $RC_PATTERNS; do names+=(-o -name "$p"); done
  find "$1" -maxdepth 6 \
    \( -name .git -o -name "Mobile Documents" -o -name "Dropbox" \) -prune -o \
    \( -type d \( "${names[@]:1}" \) -prune -print0 \) 2>/dev/null
}

# The default scan roots across every real home, NUL-terminated.
rc_default_roots() {
  local home
  for home in /Users/*; do
    [ -d "$home" ] || continue
    case "$(basename "$home")" in Shared|Guest) continue ;; esac
    rc_roots_for_home "$home"
  done
}

# Gather candidates through the three gates into the CALLER's CAND_* arrays
# (declare them local first — bash dynamic scoping). Honors RC_STALE_DAYS.
# Shared by do_reclaim and the sweep digest, so both always see with the
# same eyes.
rc_collect() {   # $@ = scan roots
  local r c parent name repo kb days now epoch home
  local TREPO="" tline
  now="$(date +%s)"
  for r in "$@"; do
    while IFS= read -r -d '' c; do
      parent="${c%/*}"; name="${c##*/}"
      rc_manifest_ok "$name" "$parent" || continue                       # gate ③
      repo="$(rc_git -C "$parent" rev-parse --show-toplevel 2>/dev/null)"
      [ -n "$repo" ] || continue                                         # no repo → gate ① can't hold
      rc_git -C "$repo" check-ignore -q "$c" 2>/dev/null || continue     # gate ①
      rc_in_vault "$parent" "$r" && continue                             # never-touch on top
      case "$c" in */Documents/*|*/Desktop/*|*/Pictures/*) continue ;; esac
      # last-touched, cached per repo (the tracked-mtime pass isn't free)
      epoch=""
      while IFS=$'\t' read -r tline; do
        case "$tline" in "$repo"$'\t'*) epoch="${tline#*$'\t'}"; break ;; esac
      done <<EOF
$TREPO
EOF
      if [ -z "$epoch" ]; then
        epoch="$(rc_repo_touched "$repo")"
        TREPO="$TREPO$repo"$'\t'"$epoch"$'\n'
      fi
      days=$(( (now - epoch) / 86400 )); [ "$epoch" -eq 0 ] && days=-1
      if [ -n "$RC_STALE_DAYS" ] && [ "$days" -ge 0 ] && [ "$days" -lt "$RC_STALE_DAYS" ]; then
        continue                                                          # too recently touched
      fi
      kb="$(du -sk "$c" 2>/dev/null | cut -f1)"; kb="${kb:-0}"
      [ "$kb" -eq 0 ] && continue
      CAND_PATH+=("$c"); CAND_REPO+=("$repo"); CAND_KB+=("$kb"); CAND_DAYS+=("$days")
      CAND_CMD+=("$(rc_rebuild_for "$name" "$parent")")
      case "$c" in
        /Users/*) home="${c#/Users/}"; CAND_OWNER+=("/Users/${home%%/*}") ;;
        *)        CAND_OWNER+=("$REAL_HOME") ;;   # off-/Users root → runner's Trash
      esac
    done < <(rc_scan_root "$r")
  done
}

# ── The UNIDENTIFIED tier ────────────────────────────────────────────────────
# The three gates deliberately hide anything they can't PROVE regenerable — so
# the folders that actually balloon a disk (a big gitignored crawl/export/cache
# with no manifest and an off-list name) stay invisible, and never get offered.
# This tier surfaces exactly those: gitignored + heavy + in a cold repo, minus
# whatever the proven scan already claimed. It proves NOTHING — it can't say the
# folder is safe, only that it's fat and the owner already told git to ignore it.
# So it is never auto-selected and never batch-deleted: each one is confirmed the
# uninstall way (type its name), because here the human is the only one who knows
# what it is. Label is honest: "unidentified", never "dangerous" (we can't prove
# either — see docs/reclaim-unidentified-spec.md).

# The repo tops under the given scan roots, NUL-terminated and de-duplicated.
rc_unid_repos() {   # $@ = scan roots → NUL repo tops
  local root g seen=$'\n' top
  for root in "$@"; do
    while IFS= read -r -d '' g; do
      top="${g%/.git}"
      case "$seen" in *$'\n'"$top"$'\n'*) continue ;; esac
      seen="$seen$top"$'\n'
      printf '%s\0' "$top"
    done < <(find "$root" -maxdepth 6 -type d -name .git -prune -print0 2>/dev/null)
  done
}

# A peek at a candidate's biggest immediate children — shown at the confirm
# prompt so the human can recognise what an unidentified folder actually is.
rc_peek() {   # $1 = dir
  du -sk "$1"/* 2>/dev/null | LC_ALL=C sort -rn | head -3 \
  | while IFS=$'\t' read -r kb path; do
      printf '        %7s  %s\n' "$(od_human_kb "$kb")" "$(basename "$path")"
    done
}

# Gather UNIDENTIFIED candidates into the CALLER's UNID_* arrays (dynamic scope,
# like rc_collect). Reads the caller's CAND_PATH to skip anything the proven
# scan already listed. git status --ignored collapses a wholly-ignored dir to a
# single entry, so a 6 GB gitignored tree costs one stat, not a walk of it.
rc_collect_unid() {   # $@ = scan roots
  local repo rel full name kb epoch days now entry home hit p
  now="$(date +%s)"
  while IFS= read -r -d '' repo; do
    epoch="$(rc_repo_touched "$repo")"
    days=$(( (now - epoch) / 86400 )); [ "$epoch" -eq 0 ] && days=-1
    if [ -n "$RC_STALE_DAYS" ] && [ "$days" -ge 0 ] && [ "$days" -lt "$RC_STALE_DAYS" ]; then
      continue                                                            # too recently touched
    fi
    while IFS= read -r -d '' entry; do
      case "$entry" in "!! "*) ;; *) continue ;; esac                    # ignored rows only
      rel="${entry#!! }"
      case "$rel" in */) ;; *) continue ;; esac                          # collapsed dirs only
      full="$repo/${rel%/}"; name="${full##*/}"
      hit=0                                                               # skip what proven already listed
      if [ "${#CAND_PATH[@]}" -gt 0 ]; then                              # bash 3.2: guard empty-array under set -u
        for p in "${CAND_PATH[@]}"; do [ "$p" = "$full" ] && { hit=1; break; }; done
      fi
      [ "$hit" -eq 1 ] && continue
      rc_in_vault "$full" "$repo" && continue                            # never-touch on top
      case "$full" in */Documents/*|*/Desktop/*|*/Pictures/*) continue ;; esac
      kb="$(du -sk "$full" 2>/dev/null | cut -f1)"; kb="${kb:-0}"
      [ "$kb" -lt "$RC_UNID_MIN_KB" ] && continue                        # below the heavy floor
      UNID_PATH+=("$full"); UNID_REPO+=("$repo"); UNID_KB+=("$kb"); UNID_DAYS+=("$days")
      case "$full" in
        /Users/*) home="${full#/Users/}"; UNID_OWNER+=("/Users/${home%%/*}") ;;
        *)        UNID_OWNER+=("$REAL_HOME") ;;
      esac
    done < <(rc_git -C "$repo" status --ignored --porcelain -z 2>/dev/null)
  done < <(rc_unid_repos "$@")
}

do_reclaim() {
  local roots=() r i m
  # roots: explicit args verbatim, else the defaults from every real home
  if [ "${#RC_ROOTS[@]}" -gt 0 ]; then
    for r in "${RC_ROOTS[@]}"; do
      [ -d "$r" ] && roots+=("$r")
    done
  else
    while IFS= read -r -d '' r; do roots+=("$r"); done < <(rc_default_roots)
  fi
  echo "============================================================"
  t rc_banner
  if [ "${#roots[@]}" -eq 0 ]; then t rc_noroots; return 1; fi
  printf '   %s ' "$(t rc_roots)"; printf '%s  ' "${roots[@]}"; echo
  [ -n "$RC_STALE_DAYS" ] && { m="$(t rc_stale_note)"; echo "   ${m//\{n\}/$RC_STALE_DAYS}"; }
  t rc_scanning
  echo "------------------------------------------------------------"

  # ---- gather PROVEN candidates through the three gates (rc_collect) ----------
  local CAND_PATH=() CAND_REPO=() CAND_CMD=() CAND_KB=() CAND_DAYS=() CAND_OWNER=()
  rc_collect "${roots[@]}"
  # ---- gather UNIDENTIFIED candidates: heavy + gitignored + cold, unprovable --
  local UNID_PATH=() UNID_REPO=() UNID_KB=() UNID_DAYS=() UNID_OWNER=()
  rc_collect_unid "${roots[@]}"

  if [ "${#CAND_PATH[@]}" -eq 0 ] && [ "${#UNID_PATH[@]}" -eq 0 ]; then
    t rc_none; echo "============================================================"; return 0
  fi

  # ---- PROVEN preview: repos ordered by their biggest find, items by size ----
  # sort key: <repo-max-kb> <repo> <item-kb> <index>
  local ORD=() n=0 total_kb=0
  if [ "${#CAND_PATH[@]}" -gt 0 ]; then
    local rows="" best j last="" stale_s
    for i in "${!CAND_PATH[@]}"; do
      best=0
      for j in "${!CAND_PATH[@]}"; do
        [ "${CAND_REPO[$j]}" = "${CAND_REPO[$i]}" ] && [ "${CAND_KB[$j]}" -gt "$best" ] && best="${CAND_KB[$j]}"
      done
      rows="$rows$best"$'\t'"${CAND_REPO[$i]}"$'\t'"${CAND_KB[$i]}"$'\t'"$i"$'\n'
    done
    while IFS=$'\t' read -r _ _ _ i; do
      [ -n "$i" ] && ORD+=("$i")
    done < <(printf '%s' "$rows" | LC_ALL=C sort -t"$(printf '\t')" -k1,1rn -k2,2 -k3,3rn)
    for i in "${ORD[@]}"; do
      if [ "${CAND_REPO[$i]}" != "$last" ]; then
        last="${CAND_REPO[$i]}"
        printf '♻️  %s\n' "$(printf '%s' "$last" | vis)"
      fi
      n=$((n + 1))
      stale_s=""
      if [ "${CAND_DAYS[$i]}" -ge 0 ]; then
        m="$(t rc_days)"; stale_s="   · ${m//\{n\}/${CAND_DAYS[$i]}}"
      fi
      printf '  %3d) %-28s %6s   rebuild: %-18s%s\n' "$n" \
        "$(printf '%s' "${CAND_PATH[$i]#"$last"/}" | vis)" \
        "$(od_human_kb "${CAND_KB[$i]}")" "${CAND_CMD[$i]}" "$stale_s"
      total_kb=$((total_kb + CAND_KB[i]))
    done
    echo "------------------------------------------------------------"
    echo "$(t un_total)$(od_human_kb "$total_kb")"
  fi

  # ---- UNIDENTIFIED preview: a NUMBERED continuation of the same list --------
  # Proven rows are 1..n; the unidentified ones continue n+1.. so BOTH tiers are
  # picked from the one number prompt (the uninstall model) — the tiers differ
  # only in how a pick is CONFIRMED (proven: batch count; 🔺: type its name).
  local UORD=()
  if [ "${#UNID_PATH[@]}" -gt 0 ]; then
    local urows="" ustale un
    for i in "${!UNID_PATH[@]}"; do urows="$urows${UNID_KB[$i]}"$'\t'"$i"$'\n'; done
    while IFS=$'\t' read -r _ i; do [ -n "$i" ] && UORD+=("$i"); done \
      < <(printf '%s' "$urows" | LC_ALL=C sort -t"$(printf '\t')" -k1,1rn)
    echo "------------------------------------------------------------"
    t rc_unid_header
    m="$(t rc_unid_note)"; echo "   ${m//\{min\}/$(od_human_kb "$RC_UNID_MIN_KB")}"
    un="$n"
    for i in "${UORD[@]}"; do
      un=$((un + 1)); ustale=""
      if [ "${UNID_DAYS[$i]}" -ge 0 ]; then m="$(t rc_days)"; ustale="   · ${m//\{n\}/${UNID_DAYS[$i]}}"; fi
      printf '  %3d) 🔺 %-36s %7s%s\n' "$un" "$(printf '%s' "${UNID_PATH[$i]}" | vis)" \
        "$(od_human_kb "${UNID_KB[$i]}")" "$ustale"
    done
  fi
  echo "============================================================"

  if [ "$DRY" -eq 1 ]; then t rc_dry_note; return 0; fi

  # ---- ONE numbered pick over both tiers -------------------------------------
  # `all` takes the PROVEN batch only — the careful 🔺 rows stay opt-in by number.
  t rc_multi_hint
  printf '%s' "$(t un_pick_prompt)"
  local choice=""; read -r choice || true
  case "$choice" in ''|q|Q) echo "============================================================"; return 0 ;; esac
  PICK_ROWS=()
  case "$choice" in
    all|ALL) local rr; for ((rr = 1; rr <= n; rr++)); do PICK_ROWS+=("$rr"); done ;;
    *) if ! pick_parse "$choice" 0 "$(( n + ${#UORD[@]} ))"; then
         t un_pick_invalid >&2; echo "============================================================"; return 2
       fi ;;
  esac

  # split the picks: row ≤ n → PROVEN (ORD); row > n → UNIDENTIFIED (UORD)
  local SEL=() sel_kb=0 UPICK=() k
  if [ "${#PICK_ROWS[@]}" -gt 0 ]; then
    for k in "${PICK_ROWS[@]}"; do
      if [ "$k" -le "$n" ]; then
        SEL+=("${ORD[$((k - 1))]}"); sel_kb=$((sel_kb + CAND_KB[${ORD[$((k - 1))]}]))
      else
        UPICK+=("${UORD[$((k - 1 - n))]}")
      fi
    done
  fi

  # PROVEN picks: one typed-count confirm for the whole batch
  if [ "${#SEL[@]}" -gt 0 ]; then
    local reply
    m="$(t rc_confirm)"; m="${m//\{n\}/${#SEL[@]}}"
    printf '%s' "${m//\{size\}/$(od_human_kb "$sel_kb")}"
    reply=""; read -r reply || true
    if [ "$reply" != "${#SEL[@]}" ]; then SEL=(); sel_kb=0; t un_cancelled; fi
  fi

  # UNIDENTIFIED picks: each confirmed by typing its own name (the safety gate)
  local USEL=() usel_kb=0
  if [ "${#UPICK[@]}" -gt 0 ]; then
    local ui uname ureply
    for ui in "${UPICK[@]}"; do
      uname="${UNID_PATH[$ui]##*/}"
      echo "------------------------------------------------------------"
      printf '  🔺 %s   %s\n' "$(printf '%s' "${UNID_PATH[$ui]}" | vis)" "$(od_human_kb "${UNID_KB[$ui]}")"
      t rc_unid_contains
      rc_peek "${UNID_PATH[$ui]}"
      m="$(t rc_unid_confirm)"; m="${m//\{name\}/$uname}"
      printf '%s' "${m//\{size\}/$(od_human_kb "${UNID_KB[$ui]}")}"
      ureply=""; read -r ureply || true
      if [ "$ureply" = "$uname" ]; then
        USEL+=("$ui"); usel_kb=$((usel_kb + UNID_KB[ui]))
      else
        t rc_unid_skip
      fi
    done
  fi

  if [ "${#SEL[@]}" -eq 0 ] && [ "${#USEL[@]}" -eq 0 ]; then
    echo "============================================================"; return 0
  fi

  # ---- one receipt for the run (kind=reclaim); PROVEN rows carry rebuild cmds -
  local rdir rfile stamp tline MV_TRIED=0 MV_MOVED=0 MV_STUCK_CONT=0
  rdir="$REAL_HOME/.sheersweep/uninstalls"
  mkdir -p "$rdir" 2>/dev/null
  stamp="$(date +%Y%m%d-%H%M%S)"
  rfile="$rdir/$stamp-reclaim.tsv"
  {
    echo "# sheersweep uninstall receipt"
    echo "# app=reclaim ($(( ${#SEL[@]} + ${#USEL[@]} )) dirs)"
    echo "# bid=reclaim"
    echo "# kind=reclaim"
    echo "# date=$stamp"
    local seen=$'\n'
    if [ "${#SEL[@]}" -gt 0 ]; then for i in "${SEL[@]}"; do
      tline="cd ${CAND_PATH[$i]%/*} && ${CAND_CMD[$i]}"
      case "$seen" in *$'\n'"$tline"$'\n'*) ;; *)
        echo "# rebuild=$tline"; seen="$seen$tline"$'\n' ;;
      esac
    done; fi
    echo "# format=nul-pairs"
    printf '\0'
  } > "$rfile" 2>/dev/null
  # bash 3.2: expanding an empty array under set -u errors, so guard each loop.
  if [ "${#SEL[@]}"  -gt 0 ]; then for i in "${SEL[@]}";  do trash_one "${CAND_PATH[$i]}" "${CAND_OWNER[$i]}" "$rfile"; done; fi
  if [ "${#USEL[@]}" -gt 0 ]; then for i in "${USEL[@]}"; do trash_one "${UNID_PATH[$i]}" "${UNID_OWNER[$i]}" "$rfile"; done; fi
  chown -R "$(stat -f %u "$REAL_HOME" 2>/dev/null):$(stat -f %g "$REAL_HOME" 2>/dev/null)" "$REAL_HOME/.sheersweep" 2>/dev/null
  [ "$MV_MOVED" -eq 0 ] && rm -f "$rfile" 2>/dev/null

  echo "============================================================"
  m="$(t rc_done)"; m="${m//\{n\}/$MV_MOVED}"
  report_moves "${m//\{size\}/$(od_human_kb "$((sel_kb + usel_kb))")}"
  return 0
}

# ============================================================================
# The sweep digest (docs/digest-spec.md): a report-only tail on every sweep of
# what the OTHER verbs can see right now — numbers and pointers, nothing is
# touched. The scans run in the background WHILE the sweep works, each result
# landing in its own file as it finishes (write tmp → mv = atomic); at digest
# time we take a short bounded grace, then print whatever is ready. A finder
# that found nothing contributes no line; an empty digest prints nothing.
# ============================================================================

DG_DIR=""
DG_PID=""

# AI-session archives: conversation history is NOT regenerable and never
# sheersweep's to touch — the digest may report the size and point at the
# owning tool, full stop. Named directories only.
# 📊 Whole-disk context. The sweep only ever frees regenerable junk, so on a
# nearly-full disk its win can be a rounding error — and the user is left with
# "I cleaned and I'm still at 95%, why?". These two finders answer that WITHOUT
# widening what the sweep touches: they only ever read.
#
# df only — instant and always reliable. A per-consumer breakdown was tried and
# cut: walking /Users took ~47 s (past dg_print's grace, so it usually never
# showed), and every entry it would list (other accounts, the Photos library)
# is something sheersweep neither can nor should touch — a look-but-don't-touch
# list is worse than the honest one line below.
dg_disk_stat() {   # → "pct used_kb free_kb"
  df -k /System/Volumes/Data | awk '/Data$/{ sub(/%/,"",$5); print $5, $3, $4 }'
}


dg_ai_kb() {   # $@ = homes → total KB (0 if none)
  local h d paths=()
  for h in "$@"; do
    for d in "$h/.claude/projects" "$h/.codex/sessions"; do
      [ -d "$d" ] && paths+=("$d")
    done
    for d in "$h/.clikae/profiles"/*/*/projects; do
      [ -d "$d" ] && paths+=("$d")
    done
  done
  [ "${#paths[@]}" -eq 0 ] && { echo 0; return 0; }
  du -sk "${paths[@]}" 2>/dev/null | awk '{s += $1} END {print s + 0}'
}

# Outdated formulae among the leaves — the same offline read `tools` flags.
dg_outdated_n() {
  brew_locate
  [ -z "$BREW_BIN" ] && { echo 0; return 0; }
  local lv od
  lv="$(brew_run leaves 2>/dev/null)"
  od="$(brew_run outdated --formula --quiet 2>/dev/null)"
  if [ -z "$lv" ] || [ -z "$od" ]; then echo 0; return 0; fi
  LC_ALL=C comm -12 \
    <(printf '%s\n' "$lv" | LC_ALL=C sort) \
    <(printf '%s\n' "$od" | LC_ALL=C sort) | grep -c . || true
}

dg_scan_start() {
  DG_DIR="$(mktemp -d "${TMPDIR:-/tmp}/sheersweep-digest.XXXXXX" 2>/dev/null)" || DG_DIR=""
  [ -z "$DG_DIR" ] && return 0
  (
    # (a subshell, not a function — plain assignments; everything is isolated)
    # The four finders run in PARALLEL, each landing its result file the moment
    # it finishes — a slow finder can only cost its own line, never the others'.
    # (Field lesson: sequential, the orphan scan starved the cheap finders past
    # the grace window and a four-line digest arrived as one line.)
    homes=()
    for home in /Users/*; do
      [ -d "$home/Library" ] || continue
      case "$(basename "$home")" in Shared|Guest) continue ;; esac
      homes+=("$home")
    done
    (
      # ♻️ build output
      CAND_PATH=(); CAND_REPO=(); CAND_CMD=(); CAND_KB=(); CAND_DAYS=(); CAND_OWNER=()
      RC_STALE_DAYS=""; roots=()
      while IFS= read -r -d '' r; do roots+=("$r"); done < <(rc_default_roots)
      if [ "${#roots[@]}" -gt 0 ]; then
        rc_collect "${roots[@]}"
      fi
      kb=0; for i in "${CAND_KB[@]-}"; do [ -n "$i" ] && kb=$((kb + i)); done
      printf '%s %s\n' "${#CAND_PATH[@]}" "$kb" > "$DG_DIR/.rc" && mv "$DG_DIR/.rc" "$DG_DIR/rc"
    ) &
    (
      # 🧟 orphaned app data (the slow one — claim scan + per-id weighing)
      collect_claims
      orphan_discover
      n=$(( ${#OD_IDS[@]} + ${#OD_TIDS[@]} ))
      kb=0
      for i in "${OD_KB[@]-}" "${OD_TKB[@]-}"; do [ -n "$i" ] && kb=$((kb + i)); done
      printf '%s %s\n' "$n" "$kb" > "$DG_DIR/.orph" && mv "$DG_DIR/.orph" "$DG_DIR/orph"
    ) &
    (
      # ↑ outdated formulae
      dg_outdated_n > "$DG_DIR/.brew" && mv "$DG_DIR/.brew" "$DG_DIR/brew"
    ) &
    (
      # 🤖 AI-session archives
      dg_ai_kb "${homes[@]}" > "$DG_DIR/.ai" && mv "$DG_DIR/.ai" "$DG_DIR/ai"
    ) &
    (
      # 📊 disk fullness — df only, lands immediately
      dg_disk_stat > "$DG_DIR/.disk" && mv "$DG_DIR/.disk" "$DG_DIR/disk"
    ) &
    wait
  ) >/dev/null 2>&1 &
  DG_PID=$!
}

# Render one finder's line ("" = it has nothing worth a line).
dg_line() {   # $1 = result key
  local n kb m
  case "$1" in
    orph) read -r n kb < "$DG_DIR/orph"
          [ "${n:-0}" -gt 0 ] || return 0
          m="$(t dg_orphans)"; m="${m//\{n\}/$n}"; printf '%s' "${m//\{size\}/$(od_human_kb "$kb")}" ;;
    rc)   read -r n kb < "$DG_DIR/rc"
          [ "${n:-0}" -gt 0 ] || return 0
          m="$(t dg_reclaim)"; m="${m//\{n\}/$n}"; printf '%s' "${m//\{size\}/$(od_human_kb "$kb")}" ;;
    brew) read -r n < "$DG_DIR/brew"
          [ "${n:-0}" -gt 0 ] || return 0
          m="$(t dg_outdated)"; printf '%s' "${m//\{n\}/$n}" ;;
    ai)   read -r kb < "$DG_DIR/ai"
          [ "${kb:-0}" -ge 102400 ] || return 0   # only worth a line from ~100 MB
          m="$(t dg_ai)"; printf '%s' "${m//\{size\}/$(od_human_kb "$kb")}" ;;
    disk) read -r pct used free < "$DG_DIR/disk"
          [ "${pct:-0}" -ge 85 ] || return 0      # only speaks up when it matters
          m="$(t dg_disk)"; m="${m//\{pct\}/$pct}"
          m="${m//\{used\}/$(od_human_kb "$used")}"
          printf '%s' "${m//\{free\}/$(od_human_kb "$free")}" ;;
  esac
}

dg_print() {
  [ -z "$DG_DIR" ] && return 0
  # STREAMED, with a bounded grace: on a real sweep the finders finished long
  # ago (everything prints at once, wait ≈ 0); on a fast dry-run each line
  # surfaces the moment its finder lands — the wait reads as activity, not a
  # hang — capped at ~10 s. A finder that misses the cap costs only its line.
  local waited=0 hdr=0 done_keys=" " key line last_pass=0 all_done=0
  while :; do
    for key in disk orph rc brew ai; do
      case "$done_keys" in *" $key "*) continue ;; esac
      [ -f "$DG_DIR/$key" ] || continue
      done_keys="$done_keys$key "
      line="$(dg_line "$key")"
      [ -z "$line" ] && continue
      if [ "$hdr" -eq 0 ]; then echo "── $(t dg_header) ──"; hdr=1; fi
      printf '   %s\n' "$line"
    done
    all_done=1
    for key in disk orph rc brew ai; do
      case "$done_keys" in *" $key "*) ;; *) all_done=0 ;; esac
    done
    [ "$all_done" -eq 1 ] && break
    [ "$last_pass" -eq 1 ] && break
    if ! kill -0 "$DG_PID" 2>/dev/null; then
      last_pass=1; continue   # job ended — one more pass for files that landed mid-loop
    fi
    [ "$waited" -ge 10 ] && break
    sleep 1; waited=$((waited + 1))
  done
  rm -rf "$DG_DIR"; DG_DIR=""
  return 0
}

# 📦 Where the space actually is — foreground, AFTER the digest, and only when the
# disk is genuinely tight. It's slow on purpose-of-physics: a per-account size on
# macOS (no quotas) means walking every inode, ~30 s on a full disk with a cold
# cache — which is exactly when this runs. So it follows the same contract as the
# uninstall footprint scan (`orphan_discover`): print a "measuring…" notice FIRST
# so the terminal is never a dead 30 seconds, then block, then show the map. Named,
# not masked (sudo already grants the read); the SIP regions no tool can total are
# derived by subtraction and labelled honestly.
# The du walk itself, factored out so its nested `case` isn't inside a command
# substitution (bash mis-parses `Shared|Guest)` there). Prints "kb<TAB>label" to
# stdout (the data). As each target finishes it also prints a "· name size" tick
# to stderr — the proof-of-life: on a full disk this walk is slow, and a terminal
# that names what it's weighing as it goes never looks hung. We deliberately don't
# promise a duration (a fuller disk is slower — a number is the one thing we can't
# honestly commit to); we show progress instead.
dg_heavy_measure() {   # stdout: kb<TAB>label ; stderr: live ticks
  local d kb bn
  _dgm_one() {   # $1 = path  $2 = label
    kb="$(du -kx -d 0 "$1" 2>/dev/null | awk '{print $1}')"
    [ -n "$kb" ] || return 0
    printf '%s\t%s\n' "$kb" "$2"                                   # data → stdout
    printf '   · %s %s\n' "$2" "$(od_human_kb "$kb")" >&2           # tick → stderr
  }
  for d in /Users/*; do
    [ -d "$d/Library" ] || continue
    bn="$(basename "$d")"
    case "$bn" in Shared|Guest) continue ;; esac
    _dgm_one "$d" "$bn"
  done
  for d in /Applications /Library /opt /private/var; do
    [ -d "$d" ] || continue
    _dgm_one "$d" "$d"
  done
}

dg_heavy_print() {
  local pct used total_seen=0 kb label line unread hpiece
  read -r pct used _ < <(dg_disk_stat)
  [ "${pct:-0}" -ge 85 ] || return 0

  t dg_heavy_scanning >&2    # notice → stderr, like the ticks (progress, not data)
  local raw; raw="$(dg_heavy_measure | sort -rn -k1,1)"
  while IFS=$'\t' read -r kb label; do [ -n "$kb" ] && total_seen=$((total_seen + kb)); done <<EOF
$raw
EOF

  local list=""
  while IFS=$'\t' read -r kb label; do
    [ -n "$kb" ] || continue
    list="${list:+$list · }$(printf '%s' "$label" | vis) $(od_human_kb "$kb")"
  done < <(printf '%s\n' "$raw" | head -3)
  unread=$(( used - total_seen ))
  if [ "$unread" -gt 1048576 ]; then
    hpiece="$(t dg_unreadable)"; hpiece="${hpiece//\{size\}/$(od_human_kb "$unread")}"
    list="${list:+$list · }$hpiece"
  fi
  [ -n "$list" ] || return 0
  line="$(t dg_heavy_line)"; printf '   %s\n' "${line//\{list\}/$list}"
}

# --- dispatch: uninstall / tools / restore / leftovers are verbs; default → sweep
# When sourced as a library for tests (SHEERSWEEP_LIB=1) we stop here: the pure
# functions above are now defined, but nothing is executed.
# shellcheck disable=SC2317  # the exit is reached only if run (not sourced) under the lib flag
if [ -n "${SHEERSWEEP_LIB:-}" ]; then return 0 2>/dev/null || exit 0; fi

if [ "$MODE" = "uninstall" ]; then
  if [ -z "$APP_TARGET" ]; then
    pick_app; pk=$?                          # no app named → show the picker
    # A non-zero pick already printed its own message (invalid selection / no
    # apps) — exit with it, don't also print "Cancelled". Only a clean q/blank
    # cancel (return 0, empty target) gets the un_cancelled line.
    [ "$pk" -ne 0 ] && exit "$pk"
    if [ "${#PICK_APPS[@]}" -gt 0 ] || [ "${#PICK_ORPHANS[@]}" -gt 0 ]; then
      # multi-select → each app runs the full one-at-a-time flow (typed-name
      # consent included; a wrong name skips THAT app, the rest still come),
      # then whatever 🧟 rows were picked run as one batch at the end.
      pk=0
      if [ "${#PICK_APPS[@]}" -gt 0 ]; then
        for arg in "${PICK_APPS[@]}"; do do_uninstall "$arg" || pk=$?; done
      fi
      if [ "${#PICK_ORPHANS[@]}" -gt 0 ]; then
        do_uninstall_orphans "${PICK_ORPHANS[@]}" || pk=$?
      fi
      exit "$pk"
    fi
    [ -z "$APP_TARGET" ] && { t un_cancelled; exit 0; }
  fi
  do_uninstall "$APP_TARGET"
  exit $?
fi
if [ "$MODE" = "tools" ]; then
  do_tools
  exit $?
fi
if [ "$MODE" = "restore" ]; then
  do_restore
  exit $?
fi
if [ "$MODE" = "leftovers" ]; then
  do_leftovers
  exit $?
fi
if [ "$MODE" = "reclaim" ]; then
  do_reclaim
  exit $?
fi

before="$(free_kb)"
echo "============================================================"
if [ "$DRY" -eq 1 ]; then t dry_banner; else echo "🧹 sheersweep"; fi
echo "$(t free_before)$(df -h /System/Volumes/Data | awk '/Data$/{print $4}')"
echo "============================================================"

# the digest's finders start now and work UNDER the sweep (docs/digest-spec.md)
dg_scan_start

# ---- per-account safe caches (every real home under /Users) ----
for home in /Users/*; do
  [ -d "$home/Library" ] || continue
  case "$(basename "$home")" in Shared|Guest) continue ;; esac
  echo "── $(t acct)$(basename "$home") ──"
  clean "$home/Library/Caches"
  clean "$home/Library/Logs"
  clean "$home/.cache"
  clean "$home/.npm"
  clean "$home/Library/Developer/Xcode/DerivedData"
  clean "$home/Library/Developer/Xcode/iOS DeviceSupport"
  clean "$home/Library/Developer/Xcode/watchOS DeviceSupport"
  clean "$home/Library/Developer/Xcode/tvOS DeviceSupport"
  clean "$home/Library/Developer/CoreSimulator/Caches"
  clean "$home/.cargo/registry/cache"
  clean "$home/.gradle/caches"
  # Node's V8 compile cache lives in the account's confstr TMPDIR, not the home —
  # resolve it AS that account. One NAMED dir inside the per-user temp area;
  # this is not (and will never be) a wholesale /var/folders sweep.
  utmp="$(sudo -u "$(basename "$home")" getconf DARWIN_USER_TEMP_DIR 2>/dev/null)"
  [ -n "$utmp" ] && [ -d "$utmp/node-compile-cache" ] && clean "${utmp%/}/node-compile-cache"
done

# ---- system-wide, once ----
echo "── $(t system) ──"
clean "/Library/Caches"
clean "/.adobeTemp"
# Deliberately NOT touching /private/var/folders — it's the live temp area; deleting
# it while logged in can break running apps.

# Homebrew old versions. Reuse brew_locate/brew_run so this shares the uninstall
# path's fixes: brew is found by absolute prefix (works on Apple Silicon under the
# sanitized sudo PATH, where the old `command -v brew` silently found nothing), it
# runs as the real user (brew refuses root), and HOMEBREW_NO_AUTO_UPDATE=1 keeps
# even this cleanup off the network.
brew_locate
if [ -n "$BREW_BIN" ]; then
  m="$(t brew)"; echo "── ${m//\{user\}/$REAL_USER} ──"
  if [ "$DRY" -eq 1 ]; then
    brew_run cleanup -n 2>/dev/null | tail -3
  else
    brew_run cleanup 2>/dev/null | tail -3
  fi
fi

# ---- release local snapshots (the step that actually returns the space) ----
# tmutil is macOS-only; guard so a non-macOS host (or a stripped image) degrades
# cleanly instead of erroring. On a real run, surface a tmutil failure rather than
# swallowing it — a silent failure here means the freed space never came back.
if ! command -v tmutil >/dev/null 2>&1; then
  echo "── $(t snap_release) ──"
  echo "   $(t snap_notool)"
elif [ "$DRY" -eq 1 ]; then
  echo "── $(t snap_dry) ──"
  n="$(tmutil listlocalsnapshots / 2>/dev/null | grep -c TimeMachine)"
  m="$(t snap_count)"; echo "   ${m//\{n\}/$n}"
else
  echo "── $(t snap_release) ──"
  snap_out="$(tmutil deletelocalsnapshots / 2>&1)"; snap_rc=$?
  printf '%s\n' "$snap_out" | tail -1
  if [ "$snap_rc" -ne 0 ]; then
    t snap_fail >&2
  fi
fi

# ---- the digest: what the other verbs can see (report only, never acts) ----
dg_print
dg_heavy_print

after="$(free_kb)"
echo "============================================================"
echo "$(t free_after)$(df -h /System/Volumes/Data | awk '/Data$/{print $4}')"
if [ "$DRY" -eq 0 ]; then
  awk -v b="$before" -v a="$after" -v L="$(t reclaimed)" 'BEGIN{printf "%s~%.1f GB\n", L, (a-b)/1024/1024}'
fi
echo "============================================================"
