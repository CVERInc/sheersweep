  esac
}

# --- args (parsed BEFORE any privilege escalation or macOS-specific call) ----
# Optional first arg is a subcommand: `uninstall <App>`. Default mode = sweep.
# $@ is never mutated, so the sudo re-exec below can replay it verbatim.
DRY=0
MODE="sweep"
APP_TARGET=""
RESTORE_LIST=0
# SHEERSWEEP_LIB=1 lets the test harness `source` this file to reach the pure
# functions below WITHOUT parsing args, escalating to sudo, or running a sweep.
if [ -z "${SHEERSWEEP_LIB:-}" ]; then
  argi=0
  for arg in "$@"; do
    argi=$((argi + 1))
    if [ "$argi" -eq 1 ]; then
      case "$arg" in
        uninstall|remove) MODE="uninstall"; continue ;;
        restore|undo)     MODE="restore";   continue ;;
      esac
    fi
    case "$arg" in
      --version|-v) echo "sheersweep $VERSION"; exit 0 ;;
      --help|-h)    print_help; exit 0 ;;
      --dry-run)    DRY=1 ;;
      --list)       RESTORE_LIST=1 ;;
      -*) m="$(t unknown)"; echo "${m//\{opt\}/$arg}" >&2; exit 2 ;;
      *)
        if [ "$MODE" = "uninstall" ] && [ -z "$APP_TARGET" ]; then
          APP_TARGET="$arg"
        else
          m="$(t unknown)"; echo "${m//\{opt\}/$arg}" >&2; exit 2
        fi ;;
    esac
  done

  # uninstall with no app name is fine on a terminal (we'll show a picker after
  # escalation). With no TTY there's nothing to pick from → fail before sudo.
  if [ "$MODE" = "uninstall" ] && [ -z "$APP_TARGET" ] && [ ! -t 0 ]; then
    t un_usage >&2; exit 2
  fi

  # macOS-only: everything below assumes tmutil, APFS, the /Users home layout and
  # ~/.Trash. --version / --help already exited above, so they work anywhere; any
  # mode that actually touches the disk refuses to run on a non-macOS host rather
  # than misbehaving against a Linux/other filesystem layout.
  if [ "$(uname -s)" != "Darwin" ]; then
    m="$(t not_macos)"; echo "${m//\{os\}/$(uname -s)}" >&2; exit 1
  fi

  # --- both modes read every account, which needs root; re-exec with sudo ------
  if [ "$(id -u)" -ne 0 ]; then
    t escalate
    exec sudo SHEERSWEEP_LANG="$SS_LANG" "$0" "$@"
  fi
  REAL_USER="${SUDO_USER:-$(id -un)}"
  REAL_HOME="$(dscl . -read "/Users/$REAL_USER" NFSHomeDirectory 2>/dev/null | awk '{print $2}')"
  [ -n "$REAL_HOME" ] || REAL_HOME="/Users/$REAL_USER"
fi

human()  { du -sh "$1" 2>/dev/null | cut -f1; }
free_kb() { df -k /System/Volumes/Data | awk '/Data$/{print $4}'; }

# Clear a directory's CONTENTS (keep the dir). Dry-run only reports the size.
clean() {
  local p="$1" sz
  [ -d "$p" ] || return 0
  sz="$(human "$p")"
  if [ -z "$sz" ] || [ "$sz" = "0B" ]; then return 0; fi
  if [ "$DRY" -eq 1 ]; then
    printf '   %s %6s  %s\n' "$(t preview)" "$sz" "$p"
  else
    printf '   %s %6s  %s\n' "$(t freeing)" "$sz" "$p"
    find "$p" -mindepth 1 -delete 2>/dev/null
  fi
}

# ============================================================================
# uninstall <App> — opt-in, dangerous-by-nature. Find one app's whole footprint
# across every account by BUNDLE ID, preview it, then MOVE it to Trash (never rm).
# Kept self-contained so the safety story reads top-to-bottom in one place.
# ============================================================================

# Resolve a name/path to an .app bundle. Sets RESOLVED_APP ("" if not found).
resolve_app() {
  RESOLVED_APP=""
  local q="$1" base hit
  case "$q" in
    /*) [ -d "$q" ] && RESOLVED_APP="$q"; return ;;   # explicit path wins
  esac
  base="$q"; case "$base" in *.app) ;; *) base="$base.app" ;; esac
  local d
  for d in "/Applications" "/Applications/Utilities" "$REAL_HOME/Applications"; do
    if [ -d "$d/$base" ]; then RESOLVED_APP="$d/$base"; return; fi
  done
  # case-insensitive fallback (Spotlight-free). Match by name and read the first
  # NUL-delimited hit, so a name with spaces/newlines is preserved; validate with
  # `[ -d ]` (follows symlinks) so a symlinked .app resolves too.
  while IFS= read -r -d '' hit; do
    [ -d "$hit" ] || continue
    RESOLVED_APP="$hit"; break
  done < <(find "/Applications" "$REAL_HOME/Applications" -maxdepth 2 -iname "$base" -not -path '*.app/*' -print0 2>/dev/null)
}

# Read CFBundleIdentifier from an .app (empty if unreadable).
bundle_id() {
  defaults read "$1/Contents/Info" CFBundleIdentifier 2>/dev/null \
    || /usr/libexec/PlistBuddy -c 'Print :CFBundleIdentifier' "$1/Contents/Info.plist" 2>/dev/null
}

# Interactive picker (mole-style): list user-removable apps, read a number,
# set APP_TARGET. Apple/system apps are filtered out. Returns with APP_TARGET
# unset on cancel / invalid input.
pick_app() {
  local apps=() appp base bid n choice
  # Scan /Applications and ~/Applications, one folder deep (so apps nested in a
  # subfolder like "CLIP STUDIO 1.5/CLIP STUDIO.app" show up) — but NEVER descend
  # into a .app bundle (its embedded helper .apps aren't separate apps).
  # NUL-delimited end to end (find -print0 · sort -z · read -d '') so an app whose
  # name contains a space, quote, or even a newline can't split or corrupt the list.
  # We match by NAME (not -type d) and validate with `[ -d ]`, which follows
  # symlinks — so a symlinked .app still appears. `-not -path '*.app/*'` keeps us
  # from descending into a bundle's embedded helper apps; without -L, find never
  # follows the symlink itself, so there's no traversal loop.
  while IFS= read -r -d '' appp; do
    [ -d "$appp" ] || continue
    bid="$(bundle_id "$appp")"
    # These folders are writable (never /System), so any Apple app found here is
    # removable — except the firmlinked ones (Safari).
    case "$bid" in ""|com.apple.Safari|com.apple.SafariTechnologyPreview) continue ;; esac
    apps+=("$appp")
  done < <(
    for d in "/Applications" "$REAL_HOME/Applications"; do
      [ -d "$d" ] && find "$d" -maxdepth 2 -name '*.app' -not -path '*.app/*' -print0 2>/dev/null
    done | sort -z
  )
  if [ "${#apps[@]}" -eq 0 ]; then t un_pick_none >&2; return 0; fi
  printf '%s (%d)\n' "$(t un_pick_header)" "${#apps[@]}"   # show the full count → no hidden "next page"
  n=0
  for appp in "${apps[@]}"; do
    n=$((n + 1))
    base="$(basename "$appp")"; base="${base%.app}"
    printf '  %3d) %s\n' "$n" "$base"
  done
  printf '%s' "$(t un_pick_prompt)"
  choice=""; read -r choice || true
  case "$choice" in
    ''|q|Q)   return 0 ;;
    *[!0-9]*) t un_pick_invalid >&2; return 0 ;;
  esac
  if [ "$choice" -lt 1 ] || [ "$choice" -gt "${#apps[@]}" ]; then
    t un_pick_invalid >&2; return 0
  fi
  APP_TARGET="${apps[$((choice - 1))]}"
}

# Move one path into a specific account's Trash (recoverable). $1=path $2=ownerHome
# Sets TRASH_DEST to the new location on success (empty if nothing moved), so the
# caller can record a receipt that `restore` later reads to put things back.
to_trash() {
  local item="$1" owner_home="$2" tdir base dest stamp i uid gid
  TRASH_DEST=""
  [ -e "$item" ] || return 0
  tdir="$owner_home/.Trash"
  # Recreate a missing .Trash with the right OWNER and 0700 perms — a Trash owned
  # by root (or world-readable) is one Finder can't empty and other users can peek
  # into. Match the home folder's owner; mode mirrors a stock ~/.Trash.
  if [ ! -d "$tdir" ]; then
    mkdir -p "$tdir" 2>/dev/null || return 0
    uid="$(stat -f %u "$owner_home" 2>/dev/null)"
    gid="$(stat -f %g "$owner_home" 2>/dev/null)"
    [ -n "$uid" ] && [ -n "$gid" ] && chown "$uid:$gid" "$tdir" 2>/dev/null
    chmod 700 "$tdir" 2>/dev/null
  fi
  base="$(basename "$item")"
  dest="$tdir/$base"
  # On a name clash, find a free slot that is GUARANTEED unique even for several
  # collisions within the same second (a coarse second-stamp would clobber the
  # earlier one and lose it). Stamp to the nanosecond, then add a probe counter
  # so it works regardless of the platform date's sub-second support.
  if [ -e "$dest" ]; then
    stamp="$(date +%Y%m%d-%H%M%S-%N 2>/dev/null)"
    case "$stamp" in *N|"") stamp="$(date +%Y%m%d-%H%M%S)" ;; esac   # date without %N
    dest="$tdir/$base $stamp"
    i=1
    while [ -e "$dest" ]; do dest="$tdir/$base $stamp-$i"; i=$((i + 1)); done
  fi
  if mv "$item" "$dest" 2>/dev/null; then TRASH_DEST="$dest"; fi
}

do_uninstall() {
  local target="$1" app bid name
  resolve_app "$target"
  app="$RESOLVED_APP"
  if [ -z "$app" ]; then
    m="$(t un_notfound)"; echo "${m//\{app\}/$target}" >&2; return 1
  fi
  # Refuse only what genuinely can't be removed — by WHERE it lives, not by who
  # made it. Apps on the sealed, read-only system volume (/System/*) are off
  # limits; removable Apple apps in /Applications (iMovie, GarageBand, the iWork
  # suite, Xcode…) are fair game. A tiny denylist covers Apple apps that sit in a
  # writable folder but are firmlinked into the system (Safari).
  case "$app" in
    /System/*) m="$(t un_refuse_apple)"; echo "${m//\{app\}/$app}" >&2; return 1 ;;
  esac
  bid="$(bundle_id "$app")"
  if [ -z "$bid" ]; then
    m="$(t un_refuse_nobid)"; echo "${m//\{app\}/$app}" >&2; return 1
  fi
  case "$bid" in
    com.apple.Safari|com.apple.SafariTechnologyPreview)
      m="$(t un_refuse_protected)"; echo "${m//\{app\}/$app}" >&2; return 1 ;;
  esac
  name="$(basename "$app")"; name="${name%.app}"

  # --- gather the footprint into parallel arrays (path / owner-home / scope) ---
  ITEM_PATH=(); ITEM_OWNER=(); ITEM_SCOPE=()
  local ascope=""
  add() {                       # add a path IF it exists, under the current scope
    [ -e "$1" ] || return 0
    ITEM_PATH+=("$1"); ITEM_OWNER+=("$2"); ITEM_SCOPE+=("$ascope")
  }

  local home u f
  for home in /Users/*; do
    [ -d "$home/Library" ] || continue
    case "$(basename "$home")" in Shared|Guest) continue ;; esac
    u="$(basename "$home")"
    ascope="$(t acct)$u"
    add "$home/Library/Application Support/$name"            "$home"
    add "$home/Library/Application Support/$bid"             "$home"
    add "$home/Library/Caches/$bid"                          "$home"
    add "$home/Library/Caches/$name"                         "$home"
    add "$home/Library/Preferences/$bid.plist"              "$home"
    for f in "$home/Library/Preferences/$bid".*.plist;   do add "$f" "$home"; done
    add "$home/Library/Containers/$bid"                     "$home"
    for f in "$home/Library/Group Containers/"*"$bid"*;  do add "$f" "$home"; done
    add "$home/Library/Saved Application State/$bid.savedState" "$home"
    for f in "$home/Library/HTTPStorages/$bid"*;         do add "$f" "$home"; done
    add "$home/Library/WebKit/$bid"                        "$home"
    add "$home/Library/Cookies/$bid.binarycookies"        "$home"
    add "$home/Library/Application Scripts/$bid"           "$home"
    add "$home/Library/Logs/$name"                         "$home"
    for f in "$home/Library/LaunchAgents/$bid"*.plist;   do add "$f" "$home"; done
  done

  # system-wide bits + the .app itself → the running user's Trash (Finder-like)
  ascope="$(t system)"
  add "$app"                                                "$REAL_HOME"
  add "/Library/Application Support/$name"                  "$REAL_HOME"
  add "/Library/Caches/$bid"                                "$REAL_HOME"
  for f in "/Library/LaunchAgents/$bid"*.plist;        do add "$f" "$REAL_HOME"; done
  for f in "/Library/LaunchDaemons/$bid"*.plist;       do add "$f" "$REAL_HOME"; done
  for f in "/Library/PrivilegedHelperTools/$bid"*;     do add "$f" "$REAL_HOME"; done

  # --- show what we found (always; this IS the product) -----------------------
  echo "============================================================"
  m="$(t un_resolved)"; m="${m//\{app\}/$app}"; echo "${m//\{bid\}/$bid}"
  echo "------------------------------------------------------------"
  if [ "${#ITEM_PATH[@]}" -eq 0 ]; then
    m="$(t un_empty)"; echo "${m//\{app\}/$name}"
    echo "============================================================"
    return 0
  fi
  m="$(t un_header)"; echo "${m//\{app\}/$name}"
  local i last=""
  for i in "${!ITEM_PATH[@]}"; do
    if [ "${ITEM_SCOPE[$i]}" != "$last" ]; then echo "── ${ITEM_SCOPE[$i]} ──"; last="${ITEM_SCOPE[$i]}"; fi
    printf '   %6s  %s\n' "$(human "${ITEM_PATH[$i]}")" "${ITEM_PATH[$i]}"
  done
  local total
  total="$(du -sch "${ITEM_PATH[@]}" 2>/dev/null | tail -1 | cut -f1)"
  echo "------------------------------------------------------------"
  echo "$(t un_total)$total"
  echo "============================================================"

  # --- dry-run stops here; nothing is touched ---------------------------------
  if [ "$DRY" -eq 1 ]; then t un_dry_note; return 0; fi

  # --- typed-name confirmation (informed consent, GitHub-delete style) --------
  m="$(t un_confirm)"; printf '%s' "${m//\{name\}/$name}"
  local reply=""; read -r reply || true
  if [ "$reply" != "$name" ]; then t un_cancelled; return 0; fi

  # ask the app to quit (best-effort, in the real user's GUI session)
  m="$(t un_quit)"; echo "${m//\{app\}/$name}"
  sudo -u "$REAL_USER" osascript -e "tell application id \"$bid\" to quit" >/dev/null 2>&1 || true

  # write a receipt as we move, so `restore` can undo this exact uninstall later.
  # The data rows are NUL-delimited (dest \0 orig \0) so a path containing a TAB
  # or a NEWLINE — both legal in a macOS filename — can't corrupt the parse. The
  # leading "# ..." header stays human-readable (its fields are controlled).
  local rdir rfile stamp moved=0
  rdir="$REAL_HOME/.sheersweep/uninstalls"
  mkdir -p "$rdir" 2>/dev/null
  stamp="$(date +%Y%m%d-%H%M%S)"
  rfile="$rdir/$stamp-$bid.tsv"
  # Header is record #1 (everything up to the first NUL); data records follow as
  # NUL-terminated dest/orig pairs. Splitting on the first NUL means neither a TAB
  # nor a NEWLINE in any path — nor in the app name — can corrupt the parse.
  {
    echo "# sheersweep uninstall receipt"
    echo "# app=$name"
    echo "# bid=$bid"
    echo "# date=$stamp"
    echo "# format=nul-pairs"   # data below: NUL-terminated dest, NUL-terminated orig, repeated
    printf '\0'                 # end-of-header sentinel: data (NUL-pairs) starts here
  } > "$rfile" 2>/dev/null
  for i in "${!ITEM_PATH[@]}"; do
    printf '   %s  %s\n' "$(t un_trashing)" "${ITEM_PATH[$i]}"
    to_trash "${ITEM_PATH[$i]}" "${ITEM_OWNER[$i]}"
    if [ -n "$TRASH_DEST" ]; then
      printf '%s\0%s\0' "$TRASH_DEST" "${ITEM_PATH[$i]}" >> "$rfile" 2>/dev/null
      moved=$((moved + 1))
    fi
  done
  # hand the receipt to the real user (we wrote it as root)
  chown -R "$(stat -f %u "$REAL_HOME" 2>/dev/null):$(stat -f %g "$REAL_HOME" 2>/dev/null)" "$REAL_HOME/.sheersweep" 2>/dev/null
  [ "$moved" -eq 0 ] && rm -f "$rfile" 2>/dev/null

  echo "============================================================"
  m="$(t un_done)"; echo "${m//\{app\}/$name}"
  return 0
}

# ============================================================================
# restore — undo the last uninstall (or list past ones). Reads the receipt and
# moves each item from the Trash back to exactly where it came from.
# ============================================================================
# Read one "# key=value" field from a receipt's header record — the first
# NUL-delimited record, i.e. the bytes before the first NUL. Scoping the read to
# the header means data bytes can never be mistaken for a header line. We use
# bash's own NUL-aware `read -d ''` because BSD awk can't split on NUL.
# $1=file $2=key
receipt_header() {
  local hdr line
  IFS= read -r -d '' hdr < "$1" 2>/dev/null || return 0
  while IFS= read -r line; do
    case "$line" in "# $2="*) printf '%s\n' "${line#"# $2="}"; return 0 ;; esac
  done <<EOF
$hdr
EOF
}

# Count the data pairs in a receipt (dest+orig per item), robust to TAB/NEWLINE
# in paths: skip the header record, then count NUL-delimited fields and halve.
receipt_count() {
  local hdr fld n=0
  { IFS= read -r -d '' hdr || true
    while IFS= read -r -d '' fld; do n=$((n + 1)); done
  } < "$1" 2>/dev/null
  echo $((n / 2))
}

# Stream the receipt's data fields (dest, orig, dest, …) as NUL-delimited records,
# skipping the header. Callers pair them up with `read -r -d ''`.
receipt_data() {
  local hdr fld
  { IFS= read -r -d '' hdr || true
    while IFS= read -r -d '' fld; do printf '%s\0' "$fld"; done
  } < "$1" 2>/dev/null
}

do_restore() {
  local rdir newest claimed app date dest orig restored=0 failed=0
  rdir="$REAL_HOME/.sheersweep/uninstalls"

  if [ "$RESTORE_LIST" -eq 1 ]; then
    t rs_list_header
    local f had=0
    for f in "$rdir"/*.tsv "$rdir"/*.tsv.restored; do
      [ -e "$f" ] || continue
      had=1
      app="$(receipt_header "$f" app)"
      date="$(receipt_header "$f" date)"
      local n; n="$(receipt_count "$f")"
      local mark=""; case "$f" in *.restored) mark=" (restored)" ;; esac
      printf '   %s   ·   %s   ·   %s item(s)%s\n' "$date" "$app" "$n" "$mark"
    done
    [ "$had" -eq 0 ] && t rs_none
    return 0
  fi

  # newest un-restored receipt
  newest=""
  local f
  for f in "$rdir"/*.tsv; do [ -e "$f" ] && newest="$f"; done   # glob is sorted → last = newest
  if [ -z "$newest" ]; then t rs_none; return 0; fi

  app="$(receipt_header "$newest" app)"
  date="$(receipt_header "$newest" date)"
  echo "============================================================"
  m="$(t rs_header)"; m="${m//\{app\}/$app}"; echo "${m//\{date\}/$date}"
  echo "------------------------------------------------------------"
  while IFS= read -r -d '' dest && IFS= read -r -d '' orig; do
    printf '   %s\n' "$orig"
  done < <(receipt_data "$newest")
  echo "============================================================"

  printf '%s' "$(t rs_confirm)"
  local reply=""; read -r reply || true
  case "$reply" in y|Y|yes|YES) ;; *) t un_cancelled; return 0 ;; esac

  # Claim this receipt atomically BEFORE touching anything: rename it to a
  # ".restoring" name. `mv` (rename(2)) is atomic, so two concurrent restores
  # can't both grab the same receipt — the loser's mv fails and it backs off,
  # and a concurrent uninstall's brand-new receipt is untouched (different name).
  claimed="$newest.restoring.$$"
  if ! mv "$newest" "$claimed" 2>/dev/null; then t rs_none; return 0; fi

  while IFS= read -r -d '' dest && IFS= read -r -d '' orig; do
    if [ ! -e "$dest" ]; then continue; fi
    if [ -e "$orig" ]; then m="$(t rs_skip)"; echo "   ${m//\{path\}/$orig}"; continue; fi
    if ! mkdir -p "$(dirname "$orig")" 2>/dev/null; then
      m="$(t rs_fail)"; echo "   ${m//\{path\}/$orig}" >&2; failed=$((failed + 1)); continue
    fi
    # mv falls back to copy+remove across filesystems, so a Trash on a different
    # volume than the original location still restores correctly.
    if mv "$dest" "$orig" 2>/dev/null; then
      printf '   %s  %s\n' "$(t rs_restoring)" "$orig"
      restored=$((restored + 1))
    else
      m="$(t rs_fail)"; echo "   ${m//\{path\}/$orig}" >&2; failed=$((failed + 1))
    fi
  done < <(receipt_data "$claimed")

  mv "$claimed" "$newest.restored" 2>/dev/null
  chown -R "$(stat -f %u "$REAL_HOME" 2>/dev/null):$(stat -f %g "$REAL_HOME" 2>/dev/null)" "$REAL_HOME/.sheersweep" 2>/dev/null
  echo "============================================================"
  m="$(t rs_done)"; echo "${m//\{app\}/$app}"
  [ "$failed" -gt 0 ] && return 1
  return 0
}

# --- dispatch: uninstall / restore are separate verbs; default → sweep ---------
# When sourced as a library for tests (SHEERSWEEP_LIB=1) we stop here: the pure
# functions above are now defined, but nothing is executed.
# shellcheck disable=SC2317  # the exit is reached only if run (not sourced) under the lib flag
if [ -n "${SHEERSWEEP_LIB:-}" ]; then return 0 2>/dev/null || exit 0; fi

if [ "$MODE" = "uninstall" ]; then
  [ -z "$APP_TARGET" ] && pick_app          # no app named → show the picker
  if [ -z "$APP_TARGET" ]; then t un_cancelled; exit 0; fi
  do_uninstall "$APP_TARGET"
  exit $?
fi
if [ "$MODE" = "restore" ]; then
  do_restore
  exit $?
fi

before="$(free_kb)"
echo "============================================================"
if [ "$DRY" -eq 1 ]; then t dry_banner; else echo "🧹 sheersweep"; fi
echo "$(t free_before)$(df -h /System/Volumes/Data | awk '/Data$/{print $4}')"
echo "============================================================"

# ---- per-account safe caches (every real home under /Users) ----
for home in /Users/*; do
  [ -d "$home/Library" ] || continue
  case "$(basename "$home")" in Shared|Guest) continue ;; esac
  echo "── $(t acct)$(basename "$home") ──"
  clean "$home/Library/Caches"
  clean "$home/Library/Logs"
  clean "$home/.cache"
  clean "$home/.npm"
  clean "$home/Library/Developer/Xcode/DerivedData"
  clean "$home/Library/Developer/Xcode/iOS DeviceSupport"
  clean "$home/Library/Developer/Xcode/watchOS DeviceSupport"
  clean "$home/Library/Developer/Xcode/tvOS DeviceSupport"
  clean "$home/Library/Developer/CoreSimulator/Caches"
  clean "$home/.cargo/registry/cache"
  clean "$home/.gradle/caches"
  clean "$home/Library/Application Support/Adobe"   # only reached if Adobe uninstalled
  clean "$home/Library/Caches/Adobe"
done

# ---- system-wide, once ----
echo "── $(t system) ──"
clean "/Library/Caches"
clean "/.adobeTemp"
# Deliberately NOT touching /private/var/folders — it's the live temp area; deleting
# it while logged in can break running apps.

# Homebrew old versions (brew refuses to run as root → use the real user)
if sudo -u "$REAL_USER" sh -c 'command -v brew' >/dev/null 2>&1; then
  m="$(t brew)"; echo "── ${m//\{user\}/$REAL_USER} ──"
  if [ "$DRY" -eq 1 ]; then
    sudo -u "$REAL_USER" brew cleanup -n 2>/dev/null | tail -3
  else
    sudo -u "$REAL_USER" brew cleanup 2>/dev/null | tail -3
  fi
fi

# ---- release local snapshots (the step that actually returns the space) ----
# tmutil is macOS-only; guard so a non-macOS host (or a stripped image) degrades
# cleanly instead of erroring. On a real run, surface a tmutil failure rather than
# swallowing it — a silent failure here means the freed space never came back.
if ! command -v tmutil >/dev/null 2>&1; then
  echo "── $(t snap_release) ──"
  echo "   $(t snap_notool)"
elif [ "$DRY" -eq 1 ]; then
  echo "── $(t snap_dry) ──"
  n="$(tmutil listlocalsnapshots / 2>/dev/null | grep -c TimeMachine)"
  m="$(t snap_count)"; echo "   ${m//\{n\}/$n}"
else
  echo "── $(t snap_release) ──"
  snap_out="$(tmutil deletelocalsnapshots / 2>&1)"; snap_rc=$?
  printf '%s\n' "$snap_out" | tail -1
  if [ "$snap_rc" -ne 0 ]; then
    t snap_fail >&2
  fi
fi

after="$(free_kb)"
echo "============================================================"
echo "$(t free_after)$(df -h /System/Volumes/Data | awk '/Data$/{print $4}')"
if [ "$DRY" -eq 0 ]; then
  awk -v b="$before" -v a="$after" -v L="$(t reclaimed)" 'BEGIN{printf "%s~%.1f GB\n", L, (a-b)/1024/1024}'
fi
echo "============================================================"
